#!/bin/sh
# frdmx-wrt net detector

LOCKFILE="/tmp/ping_check.lock"
trap 'rm -f "$LOCKFILE"; exit' INT TERM EXIT
if [ -f "$LOCKFILE" ]; then
    exit 0
fi
touch "$LOCKFILE"

MODEM_IFACES=$(uci show network | grep "proto='modemmanager'" | cut -d'.' -f2)
if [ -z "$MODEM_IFACES" ]; then
    MODEM_IFACES="modem tethering wan"
fi

TEST_IFACE=$(echo $MODEM_IFACES | awk '{print $1}')

LOCAL_IP=$(ubus call network.interface.$TEST_IFACE status 2>/dev/null | grep -A 2 '"ipv4-address"' | grep '"address"' | cut -d'"' -f4)

HTTP_CHECK=1
if [ -n "$LOCAL_IP" ]; then
    if httping -c 2 -b "$LOCAL_IP" -g http://142.250.4.102 -T 3 > /dev/null 2>&1 || \
       httping -c 2 -b "$LOCAL_IP" -g http://104.16.132.229 -T 3 > /dev/null 2>&1; then
        HTTP_CHECK=0
    fi
else
    if httping -c 2 -g http://142.250.4.102 -T 3 > /dev/null 2>&1 || \
       httping -c 2 -g http://104.16.132.229 -T 3 > /dev/null 2>&1; then
        HTTP_CHECK=0
    fi
fi

if [ "$HTTP_CHECK" -eq 1 ]; then
    echo "$(date): Internet putus (HTTP Gagal via $TEST_IFACE)! Restart Modem..." >> /var/log/internet_reboot.log

    for iface in $MODEM_IFACES; do
        ubus call network.interface.$iface down >/dev/null 2>&1
    done
    sleep 3

    if ! mmcli -m any --restart-set-to-low-power >/dev/null 2>&1; then
        mmcli -m any --restart >/dev/null 2>&1
    fi

    sleep 40

    for iface in $MODEM_IFACES; do
        ubus call network.interface.$iface up >/dev/null 2>&1
    done
    
    echo "$(date): Perbaikan selesai. Interface [ $MODEM_IFACES ] kembali aktif." >> /var/log/internet_reboot.log
fi
