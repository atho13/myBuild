#!/bin/sh
# frdmx-wrt net detector

LOCKFILE="/tmp/ping_check.lock"
LOGFILE="/var/log/internet_reboot.log"

trap 'rm -f "$LOCKFILE"; exit' INT TERM EXIT
if [ -f "$LOCKFILE" ]; then
    exit 0
fi
touch "$LOCKFILE"

WAN_IFACES=$(uci get firewall.@zone.network 2>/dev/null | tr ' ' '\n')

if [ -z "$WAN_IFACES" ]; then
    WAN_IFACES="wan wan2"
fi

for IFACE in $WAN_IFACES; do
    STATUS_DATA=$(ubus call network.interface.$IFACE status 2>/dev/null)
    [ -z "$STATUS_DATA" ] && continue

    LOCAL_IP=$(echo "$STATUS_DATA" | jsonfilter -e '@["ipv4-address"].address')
    L3_DEVICE=$(echo "$STATUS_DATA" | jsonfilter -e '@["l3_device"]')
    PROTO=$(echo "$STATUS_DATA" | jsonfilter -e '@["proto"]')

    case "$PROTO" in
        wireguard|openvpn|shadowsocks|v2ray|trojan|tun*) 
            continue 
            ;;
    esac

    HTTP_CHECK=1

    if [ -z "$LOCAL_IP" ]; then
        echo "$(date): [ $IFACE ] Tidak ada IP Lokal. Menandai putus." >> "$LOGFILE"
        HTTP_CHECK=1
    else
        if curl --interface "$IFACE" --connect-timeout 6 -sI https://google.com > /dev/null || \
           curl --interface "$IFACE" --connect-timeout 6 -sI https://cloudflare.com > /dev/null; then
            HTTP_CHECK=0
        
        elif httping -c 2 -t 6 -G -g https://detik.com > /dev/null || \
             httping -c 2 -t 6 -G -g https://biznetnetworks.com > /dev/null; then

            echo "$(date): [ $IFACE ] Tes utama gagal, gunakan web alternatif. Internet aman." >> "$LOGFILE"
            HTTP_CHECK=0
        fi
    fi

    if [ "$HTTP_CHECK" -eq 1 ]; then
        echo "$(date): [ $IFACE / $L3_DEVICE ] Internet Putus! Memulai perbaikan..." >> "$LOGFILE"

        ubus call network.interface.$IFACE down >/dev/null 2>&1
        sleep 2

        if [ "$PROTO" = "modemmanager" ] || [ "$PROTO" = "qmi" ] || [ "$PROTO" = "mbim" ] || [ "$PROTO" = "3g" ]; then
            MODEM_INDEX=$(mmcli -L 2>/dev/null | grep -o '/Modem/[0-9]' | head -n1 | cut -d'/' -f3)
            if [ -n "$MODEM_INDEX" ]; then
                mmcli -m "$MODEM_INDEX" --reset >/dev/null 2>&1
            else
                mmcli -m any --reset >/dev/null 2>&1
            fi
            
            COUNTER=0
            while [ $COUNTER -lt 12 ]; do
                sleep 5
                if mmcli -L 2>/dev/null | grep -q "Modem"; then
                    break
                fi
                COUNTER=$((COUNTER + 1))
            done

        elif [ "$PROTO" = "dhcp" ]; then
            echo "$(date): [ $IFACE ] Mencoba metode Pemutusan Daya USB (USB Power Toggle)..." >> "$LOGFILE"
            if [ -d /sys/bus/usb/devices ]; then
                for usb_dev in /sys/bus/usb/devices/*; do
                    if [ -e "$usb_dev/authorized" ]; then
                        echo 0 > "$usb_dev/authorized" 2>/dev/null
                        sleep 2
                        echo 1 > "$usb_dev/authorized" 2>/dev/null
                    fi
                done
            fi
            
            killall -q -SIGUSR2 udhcpc
            sleep 3
            
            /etc/init.d/network restart >/dev/null 2>&1
            sleep 5
            
        else
            /etc/init.d/network restart >/dev/null 2>&1
            sleep 5
        fi

        ubus call network.interface.$IFACE up >/dev/null 2>&1
        
        sleep 15
        echo "$(date): [ $IFACE ] Selesai diperbaiki dan diperintahkan aktif kembali." >> "$LOGFILE"
    fi
done
