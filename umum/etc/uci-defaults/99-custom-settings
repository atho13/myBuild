#!/bin/sh

echo "Clearing root password..."
passwd -d root > /dev/null 2>&1

echo "Setting file permissions..."
for file in \
    /usr/bin/huawei.py \
    /sbin/free.sh \
    /bin/frdmx_net \
    /etc/rc.local \
    /etc/custom_service/start_service.sh \
    /www/vnstati/vnstati.sh \
    /etc/hotplug.d/net/70-custom-wifi; do
    [ -f "$file" ] && chmod +x "$file"
done

echo "Injecting Custom Hotplug for Interface Renaming Fix..."
mkdir -p /etc/hotplug.d/net

cat << 'EOF' > /etc/hotplug.d/net/70-custom-wifi
#!/bin/sh
# Mencegat perubahan nama otomatis kernel dari phy0-sta0 kembali ke wlan0 pada STB
if [ "$ACTION" = "add" ] && [ "$INTERFACE" = "phy0-sta0" ]; then
    ip link set phy0-sta0 down
    ip link set phy0-sta0 name wlan0
    ip link set wlan0 up
fi
EOF

chmod +x /etc/hotplug.d/net/70-custom-wifi

echo "Configuring UCI settings..."
uci batch <<EOF
    set system.@system[0].hostname='FRDMX'
    set system.@system[0].timezone='WIB-7'
    set system.@system[0].zonename='Asia/Jakarta'
    
    delete system.ntp.server
    add_list system.ntp.server='0.id.pool.ntp.org'
    add_list system.ntp.server='1.id.pool.ntp.org'
    add_list system.ntp.server='time.google.com'
     
    # --- 1. DEFINISI DEVICE BRIDGE LAN
    delete network.lan_dev
    set network.lan_dev=device
    set network.lan_dev.name='br-lan'
    set network.lan_dev.type='bridge'
    # Mengikat port fisik ethernet tunggal STB ke br-lan
    add_list network.lan_dev.ports='eth0'

    # --- 2. KONFIGURASI INTERFACE LAN STATIC
    delete network.lan
    set network.lan=interface
    set network.lan.device='br-lan'
    set network.lan.proto='static'
    set network.lan.ipaddr='192.168.1.1'
    set network.lan.netmask='255.255.255.0'
    set network.lan.stp='1'
    set network.lan.igmp_snooping='1'

    # --- 3. INTERFACE WAN
    set network.wan=interface
    set network.wan.proto='dhcp'
    set network.wan.device='eth1'
    
    # --- 4. INTERFACE TETHERING
    set network.tethering=interface
    set network.tethering.proto='dhcp'
    set network.tethering.device='usb0'
    
    delete network.wan6
    
    # --- 5. FIREWALL ZONE TUNING
    del_list firewall.@zone[1].network='wan6'
    del_list firewall.@zone[1].network='tethering'
    del_list firewall.@zone[1].network='wan'
    add_list firewall.@zone[1].network='tethering'
    add_list firewall.@zone[1].network='wan'
    
    # --- 6. WEB SERVER
    set uhttpd.main.index_page='index.php'
    set uhttpd.main.interpreter='.php=/usr/bin/php-cgi'
    
    # --- 7. LAN FIX
    delete dhcp.lan
    set dhcp.lan=dhcp
    set dhcp.lan.interface='lan'
    set dhcp.lan.start='100'
    set dhcp.lan.limit='150'
    set dhcp.lan.leasetime='12h'
    
    commit network
    commit system
    commit firewall
    commit uhttpd
    commit dhcp
EOF

echo "Generating default wireless configuration profile..."
if [ -x /sbin/wifi ]; then
    > /etc/config/wireless
    wifi config > /etc/config/wireless
    
    uci set wireless.radio0.channel='6'
    uci set wireless.radio0.hwmode='11g'
    uci set wireless.radio0.country='ID'
    uci set wireless.radio0.htmode='HT20'
    uci set wireless.radio0.disabled='0'
    
    uci -q delete wireless.default_radio0
    uci set wireless.default_radio0=wifi-iface
    uci set wireless.default_radio0.device='radio0'
    uci set wireless.default_radio0.network='lan'
    uci set wireless.default_radio0.mode='ap'
    uci set wireless.default_radio0.ssid='FRDMX-Wrt'
    uci set wireless.default_radio0.encryption='none'
    uci commit wireless
fi

echo "Applying system optimizations..."
sed -i 's/^option check_signature/# option check_signature/g' /etc/opkg.conf 2>/dev/null

if [ -d /sys/block/mmcblk0 ]; then
    echo bfq > /sys/block/mmcblk0/queue/scheduler 2>/dev/null
fi
if [ -d /sys/block/sda ]; then
    echo bfq > /sys/block/sda/queue/scheduler 2>/dev/null
fi

for dev in /sys/bus/usb/devices/*/power/control; do 
    [ -e "$dev" ] && echo "on" > "$dev" 2>/dev/null
done

[ -f /etc/php.ini ] && sed -i 's/^memory_limit.*/memory_limit = 64M/' /etc/php.ini

if [ -f /etc/config/ttyd ] && [ -f /bin/bash ]; then
    uci set ttyd.@ttyd[0].command='/bin/bash --login'
    uci commit ttyd
    /etc/init.d/ttyd enable
fi

echo "Creating application symlinks for TinyFM..."
mkdir -p /www/tinyfm
ln -sf / /www/tinyfm/rootfs
ln -sf /etc/openclash/ /www/tinyfm/openclash
ln -sf /etc/openclash/ /www/tinyfm/nikki

echo "Registering start_service.sh to Startup with 30s delay..."
if [ -f "/etc/custom_service/start_service.sh" ]; then
    sed -i '/start_service.sh/d' /etc/rc.local
    sed -i '/exit 0/i (sleep 30 && /bin/bash /etc/custom_service/start_service.sh) &' /etc/rc.local
fi

echo "Updating System Schedules (Crontab)..."

cat > /etc/crontabs/root << 'EOF'
# ============================================================
# PROPERTY OF: [FRDMX-Wrt] - SCHEDULE & AUTOPILOT MAINTENANCE
# ============================================================
# Automatic Restart your Modem Bro..
30 3 * * 0 for iface in $(uci get firewall.@zone[1].network 2>/dev/null | tr ',' ' ' || echo "wan"); do ubus call network.interface.$iface down; done && sleep 2 && mmcli -m any --restart >/dev/null 2>&1 && sleep 45 && for iface in $(uci get firewall.@zone[1].network 2>/dev/null | tr ',' ' ' || echo "wan"); do ubus call network.interface.$iface up; done

# My Trick (Net Detector tiap 2 jam, jika mo pake bisa hilangkan tanda #)
# 0 */2 * * * /bin/frdmx_net

# Automatic Maintenance Internal your System Bro..
0 * * * * [ -x /sbin/free.sh ] && /sbin/free.sh >/dev/null 2>&1
59 23 * * * sync && sh -c "echo 3 > /proc/sys/vm/drop_caches" && rm -rf /tmp/luci*
*/5 * * * * [ -x /www/vnstati/vnstati.sh ] && /www/vnstati/vnstati.sh >/dev/null 2>&1
EOF

/etc/init.d/cron enable
/etc/init.d/cron restart

echo "Restarting core services..."
sysctl -p /etc/sysctl.conf >/dev/null 2>&1
/etc/init.d/network restart
/etc/init.d/uhttpd restart
/etc/init.d/ttyd restart

sleep 2
/etc/init.d/modemmanager restart

[ -f "/sbin/free.sh" ] && sh /sbin/free.sh
[ -f "/etc/custom_service/free.sh" ] && sh /etc/custom_service/free.sh

echo "Done! Router FRDM-X configuration finished successfully."
exit 0
