#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo ""
echo "{"

# --- 1. AMBIL DATA CPU ---
cpu_usage=$(top -n 1 | awk '/^CPU:/ {
    for(i=1; i<=NF; i++) {
        if($i ~ /idl/) {
            idle=substr($(i-1), 1, length($(i-1))-1); 
            print 100 - idle;
            exit;
        }
    }
}')

if [ -z "$cpu_usage" ] || ! echo "$cpu_usage" | grep -qE '^[0-9.]+$'; then
    cpu_usage=0
fi
echo "  \"cpu\": $cpu_usage,"

# --- 2. INTERFACES ---
echo "  \"interfaces\": ["
awk '
BEGIN { count = 0 }
NR > 2 {
    sub(/^[ \t]+/, "");
    split($0, a, ":");
    if (a[1] != "") {
        name = a[1];
        gsub(/[ \t]/, "", name);
        if (name != "lo") {
            if (count > 0) print ",";
            printf "    \"%s\"", name;
            count++;
        }
    }
}' /proc/net/dev
echo ""
echo "  ],"

# --- 3. DATA TRAFIK (DIPERBAIKI ANTI SPASI KOSONG) ---
echo "  \"data\": {"
awk '
BEGIN { count = 0 }
NR > 2 {
    sub(/^[ \t]+/, "");
    split($0, a, ":");
    if (a[1] != "") {
        name = a[1];
        gsub(/[ \t]/, "", name);
        if (name != "lo") {
            # Menggunakan ekspresi [ \t]+ agar spasi ganda/kosong dibersihkan otomatis oleh sistem
            split(a[2], b, /[ \t]+/);
            
            # Mengamankan posisi index data byte asli OpenWrt jika ada spasi terselip di awal kolom
            rx = (b[1] == "") ? b[2] : b[1];
            tx = (b[1] == "") ? b[10] : b[9];
            
            if (rx == "") rx = 0;
            if (tx == "") tx = 0;
            
            if (count > 0) print ",";
            printf "    \"%s\": { \"rx\": %s, \"tx\": %s }", name, rx, tx;
            count++;
        }
    }
}' /proc/net/dev
echo ""
echo "  },"

# --- 4. RAM ---
echo "  \"ram\": {"
awk '
/^MemTotal:/ { total = $2 }
/^MemAvailable:/ { available = $2 }
/^MemFree:/ && !available { free = $2 }
/^Buffers:/ { buffers = $2 }
/^Cached:/ { cached = $2 }
END {
    if (!available) {
        available = free + buffers + cached;
    }
    used = total - available;
    if (total > 0) {
        percent = int((used / total) * 100 + 0.5);
    } else {
        percent = 0;
    }
    printf "    \"total\": %d,\n", total;
    printf "    \"available\": %d,\n", available;
    printf "    \"used\": %d,\n", used;
    printf "    \"percent\": %d\n", percent;
}' /proc/meminfo
echo "  }"

echo "}"
