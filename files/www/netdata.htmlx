<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>Statistik OpenWrt</title>
    <style>
        body { font-family: system-ui, sans-serif; background: #f8fafc; color: #2d3748; margin: 0; padding: 15px; font-size: 13px; }
        .container { max-width: 1000px; margin: 0 auto; }
        .header { text-align: center; margin-bottom: 10px; }
        .h-info { display: flex; justify-content: center; gap: 10px; font-weight: 500; color: #0369a1; margin-bottom: 15px; }
        .box { background: #e0f2fe; padding: 4px 8px; border-radius: 6px; border: 1px solid #bae6fd; font-size: 12px; }
        .menu { display: flex; justify-content: center; gap: 15px; margin-bottom: 15px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; }
        .card { background: #fff; padding: 15px; border-radius: 10px; border: 1px solid #e2e8f0; box-shadow: 0 2px 4px rgba(0,0,0,.05); }
        .card h3 { font-size: 14px; margin: 0 0 10px 0; display: flex; justify-content: space-between; }
        .val { font-size: 16px; font-weight: 700; color: #0f172a; margin-bottom: 5px; }
        .track { background: #f1f5f9; border-radius: 10px; height: 10px; overflow: hidden; border: 1px solid #e2e8f0; }
        .fill { height: 100%; width: 0%; transition: width 0.4s, background 0.4s; }
        select { padding: 2px 6px; border-radius: 4px; border: 1px solid #cbd5e1; background: #fff; font-weight: 600; cursor: pointer; }
        .v-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 10px; }
        .v-card { background: #fff; padding: 10px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center; }
        .v-img { width: 100%; height: auto; border-radius: 6px; border: 1px solid #e2e8f0; background: #f8fafc; margin-top: 5px; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h2 style="color:#0284c7; margin:0 0 5px 0;">📊 Statistik OpenWrt</h2>
        <div class="h-info">
            <div id="sys-time" class="box">🕐 Memuat...</div>
            <div id="sys-net" class="box">🌍 Memuat...</div>
            <div id="sys-temp" class="box">🌡️ Suhu: --</div>
        </div>
    </div>

    <div class="menu">
        <div>📡 WAN: <select id="s-wan" onchange="save()"></select></div>
        <div>📡 LAN: <select id="s-lan" onchange="save()"></select></div>
    </div>

    <div class="grid">
        <div class="card">
            <h3><span>📡 <b id="t-wan">WAN</b></span> <span id="ip-wan" style="font-size:10px;color:#64748b"></span></h3>
            <div id="val-wan" class="val">0 B</div>
            <div class="track"><div id="b-wan" class="fill" style="width:100%; background:#0284c7"></div></div>
        </div>
        <div class="card">
            <h3><span>📡 <b id="t-lan">LAN</b></span> <span id="ip-lan" style="font-size:10px;color:#64748b"></span></h3>
            <div id="val-lan" class="val">0 B</div>
            <div class="track"><div id="b-lan" class="fill" style="width:100%; background:#4f46e5"></div></div>
        </div>
        <div class="card">
            <h3>⚡ CPU</h3>
            <div id="val-cpu" class="val">0%</div>
            <div class="track"><div id="b-cpu" class="fill"></div></div>
        </div>
        <div class="card">
            <h3>💾 RAM</h3>
            <div id="val-ram" class="val">0%</div>
            <div class="track"><div id="b-ram" class="fill" style="background:#f59e0b"></div></div>
        </div>
    </div>

    <h3 style="border-bottom:2px solid #0284c7; padding-bottom:5px; margin:25px 0 10px 0; color:#1e293b">📊 Vnstat Database (br-lan)</h3>
    <div class="v-grid">
        <div class="v-card"><span style="font-weight:600">Jam (Hourly)</span><img id="v-h" class="v-img"></div>
        <div class="v-card"><span style="font-weight:600">Hari (Daily)</span><img id="v-d" class="v-img"></div>
        <div class="v-card"><span style="font-weight:600">Bulan (Monthly)</span><img id="v-m" class="v-img"></div>
        <div class="v-card"><span style="font-weight:600">Ringkasan (Summary)</span><img id="v-s" class="v-img"></div>
    </div>
</div>

<script>
    const url = window.location.origin + '/cgi-bin/monitor.sh', roles = ['wan', 'lan'];
    let init = false;

    function fmt(kb) {
        if (!kb) return '0 B';
        const k = 1024, sizes = ['B', 'KB', 'MB', 'GB'], i = Math.floor(Math.log(kb * 1024) / Math.log(k));
        return parseFloat(((kb * 1024) / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function imgRef() {
        const t = Date.now();
        ['h','d','m','s'].forEach(x => document.getElementById(`v-${x}`).src = `/vnstati/br-lan_vnstat_${x}.png?v=${t}`);
    }

    function save() {
        roles.forEach(r => localStorage.setItem('ui_' + r, document.getElementById('s-' + r).value));
        chk();
    }

    async function chk() {
        try {
            const res = await fetch(url), d = await res.json();
            
            document.getElementById('sys-time').innerHTML = `🕐 ${d.system.time} (${d.system.uptime})`;
            document.getElementById('sys-net').innerHTML = `🌍 Internet: <span style="color:${d.system.internet==='Online'?'#10b981':'#ef4444'}">${d.system.internet}</span>`;
            document.getElementById('sys-temp').innerText = `🌡️ Suhu: ${d.temperature} °C`;

            if (!init) {
                roles.forEach(r => {
                    const s = document.getElementById('s-' + r);
                    s.innerHTML = '<option value="">- Pilihan -</option>';
                    d.interfaces.forEach(i => s.innerHTML += `<option value="${i.name}">${i.name}</option>`);
                    s.value = localStorage.getItem('ui_' + r) || '';
                });
                init = true; imgRef();
            }

            // CPU & RAM
            document.getElementById('val-cpu').innerText = Math.round(d.cpu) + '%';
            document.getElementById('b-cpu').style.width = d.cpu + '%';
            document.getElementById('b-cpu').style.background = d.cpu > 80 ? '#ef4444' : '#10b981';
            
            document.getElementById('val-ram').innerText = `${d.ram.percent}%`;
            document.getElementById('b-ram').style.width = d.ram.percent + '%';

            // Dinamis Interface (WAN & LAN)
            roles.forEach(r => {
                const name = document.getElementById('s-' + r).value;
                if (name) {
                    const info = d.interfaces.find(i => i.name === name) || { ip: '-' };
                    const n = d.data[name] || { rx: 0, tx: 0 };
                    document.getElementById(`t-${r}`).innerText = name;
                    document.getElementById(`ip-${r}`).innerText = `(${info.ip})`;
                    document.getElementById(`val-${r}`).innerHTML = `⬇️ ${fmt(n.rx/1024)} <span style="color:#f97316; font-size:11px; margin-left:5px;">▲ ${fmt(n.tx/1024)}</span>`;
                }
            });
        } catch (e) { console.error(e); }
    }

    chk(); setInterval(chk, 2000); setInterval(imgRef, 60000);
</script>
</body>
</html>
