#!/bin/sh
. /usr/share/libubox/jshn.sh

case "$1" in
    list)
        echo '{ "get_temp": {}, "get_cpu": {}, "get_traffic": {} }'
    ;;
    call)
        case "$2" in
            get_temp)
                RAW=0
                
                if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
                    RAW=$(cat /sys/class/thermal/thermal_zone0/temp)
                
                elif [ -d /sys/class/hwmon ]; then
                    for hwmon in /sys/class/hwmon/hwmon*; do
                        if [ -f "$hwmon/temp1_input" ]; then
                            RAW=$(cat "$hwmon/temp1_input")
                            break
                        fi
                    done
                fi
                
                json_init
                json_add_int "raw" "${RAW:-0}"
                json_dump
            ;;
            get_cpu)
                if [ -f /proc/stat ]; then
                    CPU_INFO=$(grep '^cpu ' /proc/stat)
                    json_init
                    json_add_string "stat" "$CPU_INFO"
                    json_dump
                fi
            ;;
            get_traffic)
                if [ -f /proc/net/dev ]; then
                    TOTAL_RX=0
                    TOTAL_TX=0
                    
                    while read -r line; do
                        case "$line" in
                            *Inter-*|*bytes*) continue ;;
                        esac
                        
                        case "$line" in
                            *:*)
                                IFACE="${line%%:*}"
                                IFACE=$(echo $IFACE)
                                
                                [ "$IFACE" = "lo" ] || [ -z "$IFACE" ] && continue
                                
                                DATA_PART="${line#*:}"
                                
                                set -- $DATA_PART
                                RX_BYTES=$1
                                TX_BYTES=$9
                                
                                TOTAL_RX=$((TOTAL_RX + ${RX_BYTES:-0}))
                                TOTAL_TX=$((TOTAL_TX + ${TX_BYTES:-0}))
                                ;;
                        esac
                    done < /proc/net/dev
                    
                    json_init
                    json_add_int "rx" "$TOTAL_RX"
                    json_add_int "tx" "$TOTAL_TX"
                    json_dump
                fi
            ;;
        esac
    ;;
esac
