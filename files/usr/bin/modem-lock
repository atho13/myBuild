#!/bin/sh
# For Frdmx-Wrt Community..

sleep 20

vids="2cb7 1199 8087 413c 1bc7 03f0 1e2d"
REAL_PATH=""

for vid in $vids; do
    device_file=$(grep -l "$vid" /sys/bus/usb/devices/*/idVendor 2>/dev/null | head -n 1)
    
    if [ -n "$device_file" ]; then
        base_dir=$(dirname "$device_file")
        REAL_PATH=$(readlink -f "$base_dir")
        logger -t "FRDMX_LOCK" "[+] Perangkat dengan VID $vid ditemukan di: $REAL_PATH"
        break
    fi
done

if [ -z "$REAL_PATH" ]; then
    for i in 1 2 3; do
        if mmcli -L >/dev/null 2>&1; then
            REAL_PATH=$(mmcli -m any 2>/dev/null | grep "device: " | grep -Eo '/sys/devices/[^ ]*')
            [ -n "$REAL_PATH" ] && break
        fi
        sleep 5
    done
fi

if [ -n "$REAL_PATH" ]; then

    interfaces=$(uci -q show network | grep -E "proto='modemmanager'|proto='qmi'|proto='mbim'" | cut -d'.' -f2 | cut -d'=' -f1 | uniq)
    NEED_RELOAD=0

    for iface in $interfaces; do
        current_device=$(uci -q get network."$iface".device)
        if [ "$current_device" != "$REAL_PATH" ]; then
            uci set network."$iface".device="$REAL_PATH"
            NEED_RELOAD=1
        fi
    done

    if [ "$NEED_RELOAD" -eq 1 ]; then
        uci commit network
        /etc/init.d/network reload
        logger -t "FRDMX_LOCK" "[+] Berhasil mengunci modem ke path baru: $REAL_PATH"
        
        sleep 5
        if [ -x /etc/init.d/mwan3 ]; then
            /etc/init.d/mwan3 restart
            logger -t "FRDMX_LOCK" "[+] MWAN3 berhasil dimuat ulang."
        fi
    fi
else
    logger -t "FRDMX_LOCK" "[-] Gagal mendapatkan sysfs path modem lewat USB VID maupun mmcli."
fi

exit 0
