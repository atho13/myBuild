#!/bin/sh
# For Frdmx-Wrt Community..

sleep 20

modprobe option 2>/dev/null
modprobe cdc_mbim 2>/dev/null
modprobe qmi_wwan 2>/dev/null
sleep 2

if [ -d /sys/bus/usb-serial/drivers/option1 ]; then
    echo "1bc7 1900" > /sys/bus/usb-serial/drivers/option1/new_id 2>/dev/null
fi

if [ -d /sys/bus/usb-net/drivers/cdc_mbim ]; then
    echo "1bc7 1900" > /sys/bus/usb-net/drivers/cdc_mbim/new_id 2>/dev/null
fi

if [ -d /sys/bus/usb/drivers/qmi_wwan ]; then
    echo "1bc7 1900" > /sys/bus/usb/drivers/qmi_wwan/new_id 2>/dev/null
fi

vids="1bc7 2cb7 2c7c 12d1 1199 8087 413c 03f0 1e2d"
REAL_PATH=""

for vid in $vids; do
    device_file=$(find /sys/bus/usb/devices/ -maxdepth 3 -name idVendor -exec grep -l "$vid" {} + 2>/dev/null | head -n 1)
    
    if [ -n "$device_file" ]; then
        base_dir=$(dirname "$device_file")
        REAL_PATH=$(readlink -f "$base_dir")
        logger -t "Modem Finder.." "[+] Perangkat dengan VID $vid ditemukan di: $REAL_PATH"
        break
    fi
done

if [ -z "$REAL_PATH" ]; then
    for i in 1 2 3; do
        if command -v mmcli >/dev/null 2>&1 && mmcli -L >/dev/null 2>&1; then
            REAL_PATH=$(mmcli -m any 2>/dev/null | grep "device: " | awk '{print $NF}' | grep -o '/sys/devices/[^ ]*')
            [ -n "$REAL_PATH" ] && break
        fi
        sleep 5
    done
fi

if [ -n "$REAL_PATH" ]; then
    interfaces=$(uci -q show network | grep -E "proto='modemmanager'|proto='qmi'|proto='mbim'" | cut -d'.' -f2 | cut -d'=' -f1 | uniq)
    NEED_RELOAD=0

    for iface in $interfaces; do
        current_device=$(uci -q get network."$iface".device)
        if [ "$current_device" != "$REAL_PATH" ]; then
            uci set network."$iface".device="$REAL_PATH"
            NEED_RELOAD=1
        fi
    done

    if [ "$NEED_RELOAD" -eq 1 ]; then
        uci commit network
        /etc/init.d/network reload
        logger -t "Modem Finder.." "[+] Berhasil mengunci modem ke path baru: $REAL_PATH"
        
        sleep 5
        if [ -x /etc/init.d/mwan3 ]; then
            /etc/init.d/mwan3 restart
            logger -t "Modem Finder.." "[+] MWAN3 berhasil dimuat ulang."
        fi
    fi
else
    logger -t "Modem Finder.." "[-] Gagal mendapatkan sysfs path modem lewat USB VID maupun mmcli."
fi

exit 0
