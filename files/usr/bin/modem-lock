#!/bin/sh
# For Frdmx-Wrt Community

sleep 20

modprobe option 2>/dev/null
modprobe cdc_mbim 2>/dev/null
modprobe qmi_wwan 2>/dev/null
sleep 2

if [ -d /sys/bus/usb-serial/drivers/option1 ]; then
    echo "1bc7 1900" > /sys/bus/usb-serial/drivers/option1/new_id 2>/dev/null
fi

vids="2c7c 2cb7 1508 1199 12d1 1bc7 1e0e 05c6 413c 03f0 19d2 9025 8087 1e2d 2b7c 0489 1c9e"
REAL_PATH=""

for vid in $vids; do
    device_file=$(find /sys/bus/usb/devices/ -maxdepth 3 -name idVendor -exec grep -li "$vid" {} + 2>/dev/null | head -n 1)
    if [ -n "$device_file" ]; then
        base_dir=$(dirname "$device_file")
        REAL_PATH=$(readlink -f "$base_dir")
        logger -t "Modem Finder" "[+] Perangkat dengan VID $vid ditemukan via sysfs: $REAL_PATH"
        break
    fi
done

if [ -z "$REAL_PATH" ]; then
    for i in 1 2 3; do
        if command -v mmcli >/dev/null 2>&1 && mmcli -L | grep -q "Modem"; then
            MM_DEVICE=$(mmcli -m any 2>/dev/null | grep -i "device:" | awk '{print $NF}')
            if [ -n "$MM_DEVICE" ]; then
                REAL_PATH=$(readlink -f "$MM_DEVICE")
                if [ -n "$REAL_PATH" ]; then
                    logger -t "Modem Finder" "[+] Modem ditemukan via mmcli: $REAL_PATH"
                    break
                fi
            fi
        fi
        sleep 5
    done
fi

if [ -n "$REAL_PATH" ] && [ -d "$REAL_PATH" ]; then
    interfaces=$(uci -q show network | grep -E "proto='modemmanager'|proto='qmi'|proto='mbim'" | cut -d'.' -f2 | cut -d'=' -f1 | uniq)
    NEED_RELOAD=0

    for iface in $interfaces; do
        current_device=$(uci -q get network."$iface".device)
        if [ "$current_device" != "$REAL_PATH" ]; then
            uci set network."$iface".device="$REAL_PATH"
            NEED_RELOAD=1
        fi
    done

    if [ "$NEED_RELOAD" = "1" ]; then
        uci commit network
        /etc/init.d/network reload
        logger -t "Modem Finder" "[+] Sukses mengunci modem ke parameter baru: $REAL_PATH"
        
        sleep 5
        if [ -x /etc/init.d/mwan3 ]; then
            /etc/init.d/mwan3 restart
            logger -t "Modem Finder" "[+] Multi-WAN (MWAN3) dimuat ulang."
        fi
    else
        logger -t "Modem Finder" "[*] Info: Path modem tetap ($REAL_PATH). Jaringan stabil."
    fi
else
     logger -t "Modem Finder" "[*] Sistem siap. Menunggu modem rakitan/modul terhubung..."
fi

exit 0
