#!/bin/sh
# For Frdmx-Wrt Community

if [ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifdown" ]; then

    REAL_DEV=""
    if [ -n "${DEVICE:-}" ]; then
        REAL_DEV="$DEVICE"
    else
        REAL_DEV=$(uci -q get network.$INTERFACE.device)
    fi

    if [ -z "$REAL_DEV" ] || [ "$REAL_DEV" = "null" ]; then
        REAL_DEV=$(uci -q get network.$INTERFACE.ifname)
    fi

    [ -z "$REAL_DEV" ] && REAL_DEV="$DEVICENAME"

    if [ -z "$REAL_DEV" ]; then
        REAL_DEV=$(ip -o link show | awk -F': ' -v iface="$INTERFACE" '$2 ~ iface {print $2}' | head -n1)
    fi

    if [ -n "$REAL_DEV" ] && [ "$REAL_DEV" != "lo" ] && ! echo "$REAL_DEV" | grep -qE '^ifb|^teql|^tun|^veth'; then
        
        # DETEKSI UNIVERSAL WAN
        IS_IN_WAN_ZONE=0
        if ip route show dev "$REAL_DEV" 2>/dev/null | grep -q "default"; then
            IS_IN_WAN_ZONE=1
        fi
        
        if [ "$IS_IN_WAN_ZONE" -eq 0 ]; then
            WAN_ZONES=$(uci show firewall | grep -E "\.name='wan'" | cut -d'[' -f2 | cut -d']' -f1)
            for zone_idx in $WAN_ZONES; do
                WAN_NETWORKS=$(uci -q get firewall.@zone["$zone_idx"].network)
                for net in $WAN_NETWORKS; do
                    if [ "$net" = "$INTERFACE" ] || [ "$net" = "${INTERFACE%6}" ]; then
                        IS_IN_WAN_ZONE=1
                        break 2
                    fi
                done
            done
        fi

        # OPTIMASI OFFLOADING & KERNEL 
        if [ "$ACTION" = "ifup" ] && echo "$REAL_DEV" | grep -qE 'br-lan|eth0'; then
            uci set firewall.@defaults.flow_offloading='1'
            uci set firewall.@defaults.flow_offloading_hw='0'
            uci commit firewall
            /etc/init.d/firewall reload >/dev/null 2>&1
            sysctl -w net.core.default_qdisc=cake >/dev/null 2>&1
            sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1
        fi

        # DETEKSI PLATFORM HARDWARE
        ARCH_TYPE=$(uname -m)
        
        if [ "$ARCH_TYPE" = "x86_64" ]; then
            MEM_LIMIT="8M"
            sysctl -w net.core.netdev_max_backlog=16384 >/dev/null 2>&1
            sysctl -w vm.dirty_background_ratio=5 >/dev/null 2>&1
            sysctl -w vm.dirty_ratio=15 >/dev/null 2>&1
        else
            MEM_LIMIT="4M"
            sysctl -w net.core.netdev_max_backlog=5000 >/dev/null 2>&1
            sysctl -w vm.dirty_background_ratio=3 >/dev/null 2>&1
            sysctl -w vm.dirty_ratio=10 >/dev/null 2>&1
        fi

        # FORMULA CAKE UTAMA
        CAKE_BASE="bandwidth unlimited besteffort nat wash rtt 100ms memlimit $MEM_LIMIT"

        # JALUR WAN
        if [ "$IS_IN_WAN_ZONE" -eq 1 ]; then
            if [ "$ACTION" = "ifup" ]; then
                [ -f "/proc/sys/net/netfilter/nf_conntrack_flush" ] && echo 1 > /proc/sys/net/netfilter/nf_conntrack_flush

                if command -v ethtool >/dev/null 2>&1; then
                    ethtool -K "$REAL_DEV" tso off gfo off gso off gro off >/dev/null 2>&1
                fi

                tc qdisc replace dev "$REAL_DEV" root cake $CAKE_BASE ack-filter dual-srchost >/dev/null 2>&1
                
                sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1
                sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1
                
                if [ -f "/sys/class/net/$REAL_DEV/queues/rx-0/rps_cpus" ] && [ "$ARCH_TYPE" != "x86_64" ]; then
                    echo "f" > "/sys/class/net/$REAL_DEV/queues/rx-0/rps_cpus" 2>/dev/null
                fi
                logger -t "Frdmx-Engine" "Connection Booster Aktif di $REAL_DEV"
            fi
            exit 0
        fi

        # JALUR LAN / WIFI AP
        if echo "$REAL_DEV" | grep -qE 'br-lan|^wlan'; then
            if [ "$ACTION" = "ifup" ]; then
                
                tc qdisc replace dev "$REAL_DEV" root cake $CAKE_BASE autorate-ingress dual-dsthost >/dev/null 2>&1
                
                [ -f "/sys/class/net/$REAL_DEV/tx_queue_len" ] && echo 1000 > "/sys/class/net/$REAL_DEV/tx_queue_len"
                
                if [ -f "/sys/class/net/$REAL_DEV/queues/rx-0/rps_cpus" ] && [ "$ARCH_TYPE" != "x86_64" ]; then
                    echo "f" > "/sys/class/net/$REAL_DEV/queues/rx-0/rps_cpus" 2>/dev/null
                fi
                logger -t "Frdmx-Engine" "Connection Booster di LAN: $REAL_DEV"
            fi
        fi
    fi
fi
