#!/bin/sh
# For Frdmx-Wrt Community..

if [ "$ACTION" = "ifup" ] || [ "$ACTION" = "bind" ] || [ "$ACTION" = "update" ]; then
    REAL_DEV=""
    if [ -n "${DEVICE:-}" ]; then
        REAL_DEV="$DEVICE"
    else
        REAL_DEV=$(uci -q get network."$INTERFACE".device)
    fi

    if [ -z "$REAL_DEV" ] || [ "$REAL_DEV" = "null" ]; then
        REAL_DEV=$(uci -q get network."$INTERFACE".ifname)
    fi

    [ -z "$REAL_DEV" ] && REAL_DEV="$DEVICENAME"

    if [ -n "$REAL_DEV" ] && [ "$REAL_DEV" != "lo" ] && [ -d "/sys/class/net/$REAL_DEV" ]; then
        
        if echo "$REAL_DEV" | grep -qE 'usb|rndis|wwan|rmnet|utun'; then

            if [ "$ACTION" = "ifup" ] || [ "$ACTION" = "bind" ]; then
                tc qdisc replace dev "$REAL_DEV" root cake diffserv3 triple-isolate nat wash rtt 100ms >/dev/null 2>&1
                logger -t "Frdmx-Optimizer" "Inisialisasi GSM Maksimal pada $REAL_DEV sukses."
                exit 0
            else
                exit 0
            fi
        fi

        if tc qdisc show dev "$REAL_DEV" 2>/dev/null | grep -q 'nat wash' && [ "$ACTION" != "ifup" ]; then
            exit 0
        fi

        IS_VALID_INTERFACE=$(uci -q get network."$INTERFACE")
        
        if [ -n "$IS_VALID_INTERFACE" ] || echo "$REAL_DEV" | grep -qE 'br-lan|eth'; then
            
            IS_MIPS=$(uname -m | grep -q 'mips' && echo 1 || echo 0)
            
            BW_LIMIT="1000mbit"
            CHECK_DEV="$REAL_DEV"
            
            if echo "$REAL_DEV" | grep -q '^br'; then
                FIRST_PORT=$(ls -1 "/sys/class/net/$REAL_DEV/brif/" 2>/dev/null | head -n 1)
                [ -n "$FIRST_PORT" ] && CHECK_DEV="$FIRST_PORT"
            fi
            
            if [ -f "/sys/class/net/$CHECK_DEV/speed" ]; then
                INTERFACE_SPEED=$(cat "/sys/class/net/$CHECK_DEV/speed" 2>/dev/null)
                if echo "$INTERFACE_SPEED" | grep -q '^[0-9]\+$' && [ "$INTERFACE_SPEED" -gt 0 ] && [ "$INTERFACE_SPEED" -lt 4000 ]; then
                    BW_LIMIT="${INTERFACE_SPEED}mbit"
                fi
            fi
            
            if [ "$IS_MIPS" = "1" ] && [ "$BW_LIMIT" = "1000mbit" ]; then
                BW_LIMIT="250mbit"
            fi

            if echo "$INTERFACE" | grep -q 'wan' && echo "$REAL_DEV" | grep -qE 'eth|enp'; then
                if [ "$BW_LIMIT" != "1000mbit" ]; then
                    BW_LOG_MODE="ISP Cable Mode ($BW_LIMIT)"
                else
                    BW_LIMIT="0"
                    BW_LOG_MODE="ISP Cable Mode (Unlimited)"
                fi
            else
                BW_LOG_MODE="$BW_LIMIT"
            fi

            if [ "$BW_LIMIT" = "0" ]; then
                tc qdisc replace dev "$REAL_DEV" root cake diffserv3 triple-isolate nat wash rtt 100ms >/dev/null 2>&1
            else
                tc qdisc replace dev "$REAL_DEV" root cake bandwidth "$BW_LIMIT" diffserv3 triple-isolate rtt 100ms >/dev/null 2>&1
            fi
            
            logger -t "Frdmx-Optimizer" "Sukses menerapkan CAKE Advanced ($BW_LOG_MODE) pada $REAL_DEV"
        fi
    fi
fi
