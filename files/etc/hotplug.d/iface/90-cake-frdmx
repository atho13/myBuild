#!/bin/sh
# For Frdmx-Wrt Community..

if [ "$ACTION" = "ifup" ] || [ "$ACTION" = "bind" ] || [ "$ACTION" = "update" ]; then
    REAL_DEV=""
    if [ -n "${DEVICE:-}" ]; then
        REAL_DEV="$DEVICE"
    else
        REAL_DEV=$(uci -q get network.$INTERFACE.device)
    fi

    if [ -z "$REAL_DEV" ] || [ "$REAL_DEV" = "null" ]; then
        REAL_DEV=$(uci -q get network.$INTERFACE.ifname)
    fi

    [ -z "$REAL_DEV" ] && REAL_DEV="$DEVICENAME"

    if [ -n "$REAL_DEV" ] && [ "$REAL_DEV" != "lo" ] && [ -d "/sys/class/net/$REAL_DEV" ]; then
        
        CURRENT_QDISC=$(tc qdisc show dev $REAL_DEV | head -n1 | awk '{print $2}')
        if [ "$CURRENT_QDISC" = "cake" ] && [ "$ACTION" != "ifup" ]; then
            exit 0
        fi

        IS_VALID_INTERFACE=$(uci -q get network.$INTERFACE)
        
        if [ -n "$IS_VALID_INTERFACE" ] || echo "$REAL_DEV" | grep -qE 'br-lan|usb0'; then
            BW_LIMIT="1gbit"
            
            CHECK_DEV="$REAL_DEV"
            IS_LAN_ZONE=0
            
            if echo "$REAL_DEV" | grep -q '^br' || echo "$INTERFACE" | grep -q 'lan'; then
                IS_LAN_ZONE=1
                if echo "$REAL_DEV" | grep -q '^br' ; then
                    FIRST_PORT=$(ls "/sys/class/net/$REAL_DEV/brif/" 2>/dev/null | head -n 1)
                    if [ -n "$FIRST_PORT" ] && [ -d "/sys/class/net/$FIRST_PORT" ]; then
                        CHECK_DEV="$FIRST_PORT"
                    elif [ -d "/sys/class/net/eth0" ]; then
                        CHECK_DEV="eth0"
                    fi
                fi
            fi
            
            if [ -f "/sys/class/net/$CHECK_DEV/speed" ]; then
                INTERFACE_SPEED=$(cat "/sys/class/net/$CHECK_DEV/speed" 2>/dev/null)
                
                if echo "$INTERFACE_SPEED" | grep -q '^[0-9]\+$' && [ "$INTERFACE_SPEED" -gt 0 ]; then
                    BW_LIMIT="${INTERFACE_SPEED}mbit"
                else
                    if [ "$IS_LAN_ZONE" = "1" ]; then
                        if [ "$CHECK_DEV" = "eth0" ]; then
                            BW_LIMIT="100mbit"
                        else
                            BW_LIMIT="1000mbit"
                        fi
                    fi
                fi
            else
                if [ "$IS_LAN_ZONE" = "1" ]; then
                    if [ "$CHECK_DEV" = "eth0" ]; then
                        BW_LIMIT="100mbit"
                    else
                        BW_LIMIT="1000mbit"
                    fi
                fi
            fi
            
            if echo "$INTERFACE" | grep -q 'wan' || echo "$REAL_DEV" | grep -qE 'usb|rndis|wwan'; then
                tc qdisc replace dev $REAL_DEV root cake bandwidth $BW_LIMIT diffserv3 triple-isolate nat wash >/dev/null 2>&1
            else
                tc qdisc replace dev $REAL_DEV root cake bandwidth $BW_LIMIT diffserv3 triple-isolate >/dev/null 2>&1
            fi
        fi
    fi
fi
