#!/bin/sh
# For Frdmx-Wrt Community..
# Smart Net Detector with Safe Limit Counter

[ "$ACTION" = "ifup" ] || exit 0

[ "$INTERFACE" = "lan" ] || [ "$INTERFACE" = "loopback" ] && exit 0

sleep 12

check_internet() {
    if ping -c 2 -W 3 1.1.1.1 >/dev/null 2>&1 || ping -c 2 -W 3 8.8.8.8 >/dev/null 2>&1; then
        return 0
    fi
    
    if command -v httping >/dev/null 2>&1; then
        if httping -q -c 2 -t 3 -g "http://1.1.1.1" >/dev/null 2>&1 || httping -q -c 2 -t 3 -g "http://google.com" >/dev/null 2>&1; then
            return 0
        fi
    fi

    if wget -q -T 3 --spider "http://1.1.1.1" >/dev/null 2>&1 || uclient-fetch -q -T 3 --spider "http://google.com" >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

if check_internet; then
    echo "0" > /tmp/.cnt_net 2>/dev/null
    exit 0
fi

CUR_CNT=$(cat /tmp/.cnt_net 2>/dev/null)
[ -z "$CUR_CNT" ] && CUR_CNT=0

if [ "$CUR_CNT" -ge 3 ]; then
    (
        for usb_dev in /sys/bus/usb/devices/[0-9]*; do
            [ -e "$usb_dev/product" ] || continue
            id_bus=$(basename "$usb_dev")
            
            echo "$id_bus" > /sys/bus/usb/drivers/usb/unbind 2>/dev/null
            sleep 2
            echo "$id_bus" > /sys/bus/usb/drivers/usb/bind 2>/dev/null
        done
        
        echo "0" > /tmp/.cnt_net 2>/dev/null
    ) &
    exit 0
fi

CUR_CNT=$((CUR_CNT + 1))
echo "$CUR_CNT" > /tmp/.cnt_net 2>/dev/null

(
    sleep 2
    
    if command -v mmcli >/dev/null 2>&1; then
        M_IDX=$(mmcli -L 2>/dev/null | grep -oE '/Modem/[0-9]+' | cut -d'/' -f3)
        if [ -n "$M_IDX" ]; then
            mmcli -m "$M_IDX" --simple-disconnect >/dev/null 2>&1
            sleep 2
        fi
    fi
    
    if command -v gcom >/dev/null 2>&1 && uci -q get network."$INTERFACE".device >/dev/null; then
        DEV_TTY=$(uci -q get network."$INTERFACE".device)
        [ -n "$DEV_TTY" ] && gcom -d "$DEV_TTY" >/dev/null 2>&1
    fi

    ubus call network.interface."$INTERFACE" down >/dev/null 2>&1
    sleep 3
    ubus call network.interface."$INTERFACE" up >/dev/null 2>&1
) &

exit 0
