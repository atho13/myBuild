#!/bin/sh
# For Frdmx-Wrt Community..
# Smart Net Detector & Dynamic Tunnel Watchdog

[ "$ACTION" = "ifup" ] || exit 0

[ "$INTERFACE" = "lan" ] || [ "$INTERFACE" = "loopback" ] || [ "$INTERFACE" = "wan6" ] && exit 0

sleep 10

check_internet() {
    if ping -c 2 -W 3 1.1.1.1 >/dev/null 2>&1 || ping -c 2 -W 3 8.8.8.8 >/dev/null 2>&1; then
        return 0
    fi
    
    # Metode 2: Cek HTTP jika aplikasi httping terpasang
    if command -v httping >/dev/null 2>&1; then
        if httping -q -c 2 -t 3 -g "http://1.1.1.1" >/dev/null 2>&1 || httping -q -c 2 -t 3 -g "http://google.com" >/dev/null 2>&1; then
            return 0
        fi
    fi

    if wget -q -T 3 --spider "http://1.1.1.1" >/dev/null 2>&1 || uclient-fetch -q -T 3 --spider "http://google.com" >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

if check_internet; then
    echo "0" > /tmp/.cnt_net 2>/dev/null
    
    /etc/init.d/dnsmasq restart >/dev/null 2>&1
    
    if [ -f "/etc/init.d/passwall" ] && /etc/init.d/passwall status | grep -q "running"; then
        /etc/init.d/passwall restart >/dev/null 2>&1
    fi
    
    if [ -f "/etc/init.d/openclash" ] && /etc/init.d/openclash -v >/dev/null 2>&1; then
        if pidof clash >/dev/null 2>&1; then
            /etc/init.d/openclash restart >/dev/null 2>&1
        fi
    fi

    if [ -f "/etc/init.d/qtun" ] && /etc/init.d/qtun status | grep -q "running"; then
        /etc/init.d/qtun restart >/dev/null 2>&1
    fi

    exit 0
fi

CUR_CNT=$(cat /tmp/.cnt_net 2>/dev/null)
[ -z "$CUR_CNT" ] && CUR_CNT=0

if [ "$CUR_CNT" -ge 3 ]; then
    (
        if [ -x "/usr/sbin/conntrack" ]; then
            conntrack -F >/dev/null 2>&1
        elif [ -e "/proc/net/nf_conntrack" ]; then
            echo 1 > /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null
            sleep 1
            echo 65536 > /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null
        fi

        /etc/init.d/dnsmasq restart >/dev/null 2>&1

        echo "0" > /tmp/.cnt_net 2>/dev/null
    ) &
    exit 0
fi

CUR_CNT=$((CUR_CNT + 1))
echo "$CUR_CNT" > /tmp/.cnt_net 2>/dev/null

(
    sleep 2
    ifup "$INTERFACE" >/dev/null 2>&1
) &

exit 0
