#!/bin/sh
# For Frdmx-Wrt Community..

[ "$ACTION" = "ifup" ] || exit 0
[ -z "$INTERFACE" ] && exit 0

IS_WAN=$(uci -q get firewall.wan.network | grep -w "$INTERFACE")
if [ -z "$IS_WAN" ]; then
    IS_WAN=$(uci -q show firewall | grep -E "\.name='wan'" | cut -d'.' -f1,2 | xargs -I {} uci -q get {}.network | grep -w "$INTERFACE")
fi
[ -z "$IS_WAN" ] && exit 0


PID_FILE="/var/run/frdmx_watchdog_${INTERFACE}.pid"

if [ -f "$PID_FILE" ]; then
    OLD_PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        logger -t "Frdmx-Watchdog" "[FW-Guard] Menghentikan proses pengawasan lama (${INTERFACE} - PID: $OLD_PID)."
        kill -9 "$OLD_PID" 2>/dev/null
    fi
fi

(
    echo "$$" > "$PID_FILE"
    sleep 5

    TARGET_1="1.1.1.1"
    TARGET_2="8.8.8.8"

    MAX_RESETS=3
    
    COUNTER_FILE="/tmp/frdmx_net_${INTERFACE}"

    check_ping() {
        if ping -c 1 -W 2 -I "$INTERFACE" "$1" >/dev/null 2>&1; then
            return 0
        fi
        return 1
    }

    logger -t "Frdmx-Watchdog" "Memulai pengawasan terisolasi pada: $INTERFACE (PID: $$)"

    while true; do

        if ! uci -q show network."$INTERFACE" >/dev/null; then
            logger -t "Frdmx-Watchdog" "Antarmuka $INTERFACE dihapus, menutup pengawasan."
            break
        fi

        if check_ping "$TARGET_1" || check_ping "$TARGET_2"; then
            echo "0" > "$COUNTER_FILE"
            sleep 60
            continue
        fi

        CURRENT_COUNT=$(cat "$COUNTER_FILE" 2>/dev/null)
        [ -z "$CURRENT_COUNT" ] && CURRENT_COUNT=0

        if [ "$CURRENT_COUNT" -ge "$MAX_RESETS" ]; then
            logger -t "Frdmx-Watchdog" "Batas maksimal reset tercapai pada $INTERFACE. Istirahat 3 menit."
            sleep 180 
            echo "0" > "$COUNTER_FILE"
            continue
        fi

        CURRENT_COUNT=$((CURRENT_COUNT + 1))
        echo "$CURRENT_COUNT" > "$COUNTER_FILE"
        logger -t "Frdmx-Watchdog" "Koneksi terputus pada $INTERFACE. Memicu IP baru (Percobaan $CURRENT_COUNT/$MAX_RESETS)..."
        
       
        if command -v mmcli >/dev/null 2>&1; then

            DEV_NAME=$(ubus call network.interface."$INTERFACE" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
            [ -z "$DEV_NAME" ] && DEV_NAME=$(uci -q get network."$INTERFACE".device)
            [ -z "$DEV_NAME" ] && DEV_NAME=$(uci -q get network."$INTERFACE".ifname)
            
            if [ -n "$DEV_NAME" ]; then

                MODEM_INDEX=$(mmcli -L 2>/dev/null | grep -F "[$DEV_NAME]" | grep -oE '/Modem/[0-9]+' | cut -d'/' -f3)
            fi
            
            [ -z "$MODEM_INDEX" ] && MODEM_INDEX=$(mmcli -L 2>/dev/null | grep -oE '/Modem/[0-9]+' | cut -d'/' -f3 | head -n 1)

            if [ -n "$MODEM_INDEX" ]; then
                logger -t "Frdmx-Watchdog" "[$INTERFACE - Rakitan Index $MODEM_INDEX] Memutus koneksi seluler."
                mmcli -m "$MODEM_INDEX" --simple-disconnect >/dev/null 2>&1
                sleep 1
            fi
        fi

       
        WAN_GATEWAY=$(ip route show dev "$INTERFACE" | grep default | awk '{print $3}' | head -n 1)

        if [ -n "$WAN_GATEWAY" ]; then
            
            if wget -q --timeout=1 --spider "http://${WAN_GATEWAY}/html/index.html" >/dev/null 2>&1; then
                logger -t "Frdmx-Watchdog" "[$INTERFACE - HiLink] Mengekstrak token keamanan dari gateway ${WAN_GATEWAY}"
                
                TOK_INFO=$(wget -qO- --timeout=3 "http://${WAN_GATEWAY}/api/webserver/SesTokInfo" 2>/dev/null)
                
                if [ -n "$TOK_INFO" ]; then
                    H_COOKIE=$(echo "$TOK_INFO" | grep -oE '<SesInfo>[^<]+' | sed 's/<SesInfo>//')
                    H_TOKEN=$(echo "$TOK_INFO" | grep -oE '<TokInfo>[^<]+' | sed 's/<TokInfo>//')
                fi

                WGET_HEADER=""
                [ -n "$H_COOKIE" ] && WGET_HEADER="--header=Cookie: $H_COOKIE"
                [ -n "$H_TOKEN" ] && WGET_HEADER="$WGET_HEADER --header=__RequestVerificationToken: $H_TOKEN"

                logger -t "Frdmx-Watchdog" "[$INTERFACE - HiLink] Melakukan rotasi IP melalui perintah API."
                
                wget -qO- --timeout=2 $WGET_HEADER "http://${WAN_GATEWAY}/api/dialup/mobile-dataswitch" --post-data="<request><dataswitch>0</dataswitch></request>" >/dev/null 2>&1
                sleep 1.5
                
                wget -qO- --timeout=2 $WGET_HEADER "http://${WAN_GATEWAY}/api/dialup/mobile-dataswitch" --post-data="<request><dataswitch>1</dataswitch></request>" >/dev/null 2>&1
                sleep 1
            fi
        fi
        
        logger -t "Frdmx-Watchdog" "[$INTERFACE - Kick] Membangun kembali sistem jaringan."
        ifup "$INTERFACE" 2>/dev/null

        sleep 15
    done

    rm -f "$COUNTER_FILE" "$PID_FILE" 2>/dev/null
) &

exit 0
