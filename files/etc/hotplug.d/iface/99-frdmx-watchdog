#!/bin/sh
# For Frdmx-Wrt Community..
# Smart Net Detector - Universal
# Author: Frdmx-Wrt

[ "$ACTION" = "ifup" ] || exit 0
[ -z "$INTERFACE" ] && exit 0

IS_WAN=$(uci -q get firewall.wan.network | grep -w "$INTERFACE")
if [ -z "$IS_WAN" ]; then
    IS_WAN=$(uci -q show firewall | grep -E "\.name='wan'" | cut -d'.' -f1,2 | xargs -I {} uci -q get {}.network | grep -w "$INTERFACE")
fi

[ -z "$IS_WAN" ] && exit 0

PID_FILE="/var/run/frdmx_watchdog_${INTERFACE}.pid"
if [ -f "$PID_FILE" ]; then
    OLD_PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
        logger -t "Frdmx-Watchdog" "Membunuh proses pengawasan lama (PID: $OLD_PID) untuk $INTERFACE agar tidak duplikasi."
        kill "$OLD_PID" 2>/dev/null
        sleep 1
    fi
fi

(
    echo "$$" > "$PID_FILE"

    sleep 30

    TARGET_PRIMARY_1="http://1.1.1.1"
    TARGET_PRIMARY_2="http://google.com"
    TARGET_BACKUP_1="http://biznet.id"
    TARGET_BACKUP_2="http://kompas.com"

    TIMEOUT_MS=5000
    COUNT=2
    MAX_RESETS=3
    COUNTER_FILE="/tmp/frdmx_net_${INTERFACE}"

    check_http() {
        local target=$1
        if command -v httping >/dev/null 2>&1; then
            if httping -q -c "$COUNT" -t "$((TIMEOUT_MS / 1000))" -g "$target" 2>/dev/null; then
                return 0
            fi
        else
            if wget -q -T "$((TIMEOUT_MS / 1000))" --spider "$target" >/dev/null 2>&1; then
                return 0
            fi
        fi
        return 1
    }

    logger -t "Frdmx-Watchdog" "Memulai pengawasan internet pada interface: $INTERFACE (PID: $$)"

    while true; do
    
        if ! uci -q show network."$INTERFACE" >/dev/null; then
            logger -t "Frdmx-Watchdog" "Antarmuka $INTERFACE dihapus dari sistem, menghentikan pengawasan."
            break
        fi

        if check_http "$TARGET_PRIMARY_1" || check_http "$TARGET_PRIMARY_2"; then
            echo "0" > "$COUNTER_FILE"
            sleep 120  # Waktu tunggu berkala saat internet normal
            continue
        fi

        if check_http "$TARGET_BACKUP_1" || check_http "$TARGET_BACKUP_2"; then
            echo "0" > "$COUNTER_FILE"
            sleep 120
            continue
        fi

        CURRENT_COUNT=$(cat "$COUNTER_FILE" 2>/dev/null)
        [ -z "$CURRENT_COUNT" ] && CURRENT_COUNT=0

        if [ "$CURRENT_COUNT" -ge "$MAX_RESETS" ]; then
            logger -t "Frdmx-Watchdog" "PERINGATAN: Batas maksimal reset ($MAX_RESETS kali) terpenuhi pada $INTERFACE. Mengistirahatkan modem 5 menit."
            sleep 300 
            echo "0" > "$COUNTER_FILE"
            continue
        fi

        CURRENT_COUNT=$((CURRENT_COUNT + 1))
        echo "$CURRENT_COUNT" > "$COUNTER_FILE"
        logger -t "Frdmx-Watchdog" "Koneksi terputus pada $INTERFACE. Melakukan pemulihan jaringan (Percobaan $CURRENT_COUNT/$MAX_RESETS)..."

        if command -v mmcli >/dev/null 2>&1; then
            MODEM_INDEX=$(mmcli -L 2>/dev/null | grep -oE '/Modem/[0-9]+' | cut -d'/' -f3)
            if [ -n "$MODEM_INDEX" ]; then
                mmcli -m "$MODEM_INDEX" --simple-disconnect >/dev/null 2>&1
                sleep 3
            fi
        fi
        
        ifup "$INTERFACE" 2>/dev/null

        sleep 40
    done

    rm -f "$COUNTER_FILE" "$PID_FILE" 2>/dev/null
) &

exit 0
