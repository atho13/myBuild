#!/bin/sh
# For Frdmx-Wrt Community..

[ "$ACTION" = "ifup" ] || exit 0
[ -z "$INTERFACE" ] && exit 0

IS_WAN=$(uci -q get firewall.wan.network | grep -w "$INTERFACE")
if [ -z "$IS_WAN" ]; then
    IS_WAN=$(uci -q show firewall | grep -E "\.name='wan'" | cut -d'.' -f1,2 | xargs -I {} uci -q get {}.network | grep -w "$INTERFACE")
fi

[ -z "$IS_WAN" ] && exit 0

(
    sleep 45

    TARGET_PRIMARY_1="http://1.1.1.1"
    TARGET_PRIMARY_2="http://google.com"
    TARGET_BACKUP_1="http://biznetnetworks.com"
    TARGET_BACKUP_2="http://kompas.com"

    TIMEOUT_MS=5000
    COUNT=2
    MAX_RESETS=3
    COUNTER_FILE="/tmp/frdmx_net_${INTERFACE}"

    check_http() {
        local target=$1
        if command -v httping >/dev/null 2>&1; then
            if httping -q -c "$COUNT" -t "$((TIMEOUT_MS / 1000))" -g "$target" 2>/dev/null; then
                return 0
            fi
        else
            if wget -q -T "$((TIMEOUT_MS / 1000))" --spider "$target" >/dev/null 2>&1; then
                return 0
            fi
        fi
        return 1
    }

    fast_trigger_modem() {
        logger -t "Frdmx-Watchdog" "[${INTERFACE}] Memeriksa jenis driver hardware..."
        
        local dev_name=$(uci -q get network."$INTERFACE".device)
        [ -z "$dev_name" ] && dev_name=$(uci -q get network."$INTERFACE".ifname)
        [ -z "$dev_name" ] && return 0

        local kernel_driver=""
        if [ -d "/sys/class/net/${dev_name}/device/driver" ]; then
            kernel_driver=$(basename $(readlink /sys/class/net/${dev_name}/device/driver))
        fi

        if echo "$kernel_driver" | grep -qEi 'cdc_ether|rndis_host|ppp'; then
            logger -t "Frdmx-Watchdog" "[${INTERFACE}] Driver lawas terdeteksi (${kernel_driver}). Menjalankan trigger fast-boot..."
            
            local at_port=""
            for port in /dev/ttyUSB2 /dev/ttyUSB1 /dev/ttyUSB0 /dev/ttyACM0 /dev/ttyACM1; do
                if [ -c "$port" ]; then
                    at_port="$port"
                    break
                fi
            done

            if [ -n "$at_port" ]; then
                logger -t "Frdmx-Watchdog" "[${INTERFACE}] Mengirimkan sinyal refresh jaringan ke ${at_port}..."
                echo -e "AT+CFUN=4\r" > "$at_port" 2>/dev/null
                sleep 2
                echo -e "AT+CFUN=1\r" > "$at_port" 2>/dev/null
                sleep 3
            else
                if command -v usbreset >/dev/null 2>&1; then
                    local usb_devs=$(lsusb | grep -iE 'midol|lte|cdcecm|rndis' | awk '{print $6}')
                    for dev in $usb_devs; do
                        logger -t "Frdmx-Watchdog" "[${INTERFACE}] Memaksa hardware usbreset pada perangkat lawas: ${dev}"
                        usbreset "$dev" >/dev/null 2>&1
                        sleep 4
                    done
                fi
            fi
            
            ifdown "$INTERFACE" 2>/dev/null
            /etc/init.d/network reload 2>/dev/null
            sleep 2
        else
            logger -t "Frdmx-Watchdog" "[${INTERFACE}] Driver terdeteksi sebagai ${kernel_driver:-unknown}. Melewati trigger lawas."
        fi
    }

    logger -t "Frdmx-Watchdog" "Memulai pengawasan internet pada interface: $INTERFACE"

    while true; do

        if ! uci -q show network."$INTERFACE" >/dev/null; then
            rm -f "$COUNTER_FILE" 2>/dev/null
            logger -t "Frdmx-Watchdog" "Antarmuka $INTERFACE dicopot, menghentikan pengawasan."
            break
        fi

        if check_http "$TARGET_PRIMARY_1" || check_http "$TARGET_PRIMARY_2"; then
            echo "0" > "$COUNTER_FILE"
            sleep 60  
            continue
        fi

        if check_http "$TARGET_BACKUP_1" || check_http "$TARGET_BACKUP_2"; then
            echo "0" > "$COUNTER_FILE"
            sleep 60
            continue
        fi

        CURRENT_COUNT=$(cat "$COUNTER_FILE" 2>/dev/null)
        [ -z "$CURRENT_COUNT" ] && CURRENT_COUNT=0

        if [ "$CURRENT_COUNT" -ge "$MAX_RESETS" ]; then
            logger -t "Frdmx-Watchdog" "PERINGATAN: Batas maksimal reset ($MAX_RESETS kali) terpenuhi pada $INTERFACE. Mengistirahatkan pemulihan 10 menit."
            sleep 600 
            echo "0" > "$COUNTER_FILE"
            continue
        fi

        CURRENT_COUNT=$((CURRENT_COUNT + 1))
        echo "$CURRENT_COUNT" > "$COUNTER_FILE"
        logger -t "Frdmx-Watchdog" "Koneksi terputus pada $INTERFACE. Melakukan pemulihan jaringan (Percobaan $CURRENT_COUNT/$MAX_RESETS)..."

        if command -v mmcli >/dev/null 2>&1; then
            MODEM_INDEX=$(mmcli -L 2>/dev/null | grep -oE '/Modem/[0-9]+' | head -n 1 | cut -d'/' -f3)
            if [ -n "$MODEM_INDEX" ]; then
                mmcli -m "$MODEM_INDEX" --simple-disconnect >/dev/null 2>&1
                sleep 3
            fi
        fi
        
        fast_trigger_modem
        
        ifup "$INTERFACE" 2>/dev/null
        
        local dev_name=$(uci -q get network."$INTERFACE".device)
        [ -z "$dev_name" ] && dev_name=$(uci -q get network."$INTERFACE".ifname)
        if [ -n "$dev_name" ] && command -v ubus >/dev/null 2>&1; then
            ubus call network.interface."$INTERFACE" renew >/dev/null 2>&1
        fi
        
        sleep 45
    done
) &

exit 0
