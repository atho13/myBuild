#!/bin/sh
# ========================
# PROPERTY OF: [FRDMX-Wrt]
# ========================

[ "$ACTION" = "add" ] || exit 0

VID=$(echo "$PRODUCT" | cut -d'/' -f1 | tr 'A-Z' 'a-z')
PID=$(echo "$PRODUCT" | cut -d'/' -f2 | tr 'A-Z' 'a-z')

case "$VID" in
    "2c7c"|"1199"|"2cb7"|"12d1"|"05c6"|"1e0e"|"413c"|"03f0"|"19d2"|"0b3c"|"1546"|"2b7c"|"0489"|"1c9e"|"1bc7")

        sleep 2
        
        if [ -d "/sys/bus/usb/devices/$DEVICENAME" ]; then
            VID_FINAL=$(cat "/sys/bus/usb/devices/$DEVICENAME/idVendor" 2>/dev/null | tr 'A-Z' 'a-z')
            PID_FINAL=$(cat "/sys/bus/usb/devices/$DEVICENAME/idProduct" 2>/dev/null | tr 'A-Z' 'a-z')
            [ -n "$VID_FINAL" ] && VID=$VID_FINAL
            [ -n "$PID_FINAL" ] && PID=$PID_FINAL
        fi

        if [ "$VID" = "2cb7" ] && { [ "$PID" = "0007" ] || [ "$PID" = "0001" ] || [ "$PID" = "0010" ]; }; then
            logger -t "MODEM_RAKITAN" "[+] Terdeteksi Intel XMM Fibocom. Menyerahkan ke driver CDC_MBIM secara native."
            exit 0
        fi

        if [ -d "/sys/bus/usb-serial/drivers/option1" ]; then
            VID_CLEAN=$(printf "%x" "0x$VID" 2>/dev/null)
            PID_CLEAN=$(printf "%x" "0x$PID" 2>/dev/null)

            if ! grep -qEi "^$VID_CLEAN[[:space:]]+$PID_CLEAN" /sys/bus/usb-serial/drivers/option1/products 2>/dev/null; then
                echo "0x$VID_CLEAN 0x$PID_CLEAN" > /sys/bus/usb-serial/drivers/option1/new_id 2>/dev/null
                sleep 2 
            fi
            
            PORTS=""
            if [ -d "/sys/bus/usb/devices/$DEVICENAME" ]; then
                PORTS=$(find "/sys/bus/usb/devices/$DEVICENAME/" -name "ttyUSB*" -o -name "cdc-wdm*" -o -name "ttyACM*" 2>/dev/null | xargs -I {} basename {} | tr '\n' ' ')
            fi
            
            logger -t "MODEM_RAKITAN" "[+] Sukses menyuntikkan USB VID:$VID PID:$PID ke Driver Option. Port terikat: [ ${PORTS:-Menunggu Inisialisasi} ]"
        else
            logger -t "MODEM_RAKITAN" "[-] Gagal mengaktifkan port serial. Modul kmod-usb-serial-option belum termuat!"
        fi
        ;;
    *)
        exit 0
        ;;
esac
