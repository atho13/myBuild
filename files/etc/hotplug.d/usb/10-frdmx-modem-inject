#!/bin/sh
# For Frdmx-Wrt Community..

[ "$ACTION" = "add" ] || exit 0

VID=$(echo "$PRODUCT" | cut -d'/' -f1 | tr 'A-Z' 'a-z')
PID=$(echo "$PRODUCT" | cut -d'/' -f2 | tr 'A-Z' 'a-z')

case "$VID" in
    "2c7c"|"1199"|"2cb7"|"12d1"|"05c6"|"1e0e"|"413c"|"03f0"|"19d2"|"0b3c"|"1546"|"2b7c"|"0489"|"1c9e")

        sleep 3
        
        if [ -d "/sys/bus/usb/devices/$DEVICENAME" ]; then
            VID_FINAL=$(cat "/sys/bus/usb/devices/$DEVICENAME/idVendor" 2>/dev/null | tr 'A-Z' 'a-z')
            PID_FINAL=$(cat "/sys/bus/usb/devices/$DEVICENAME/idProduct" 2>/dev/null | tr 'A-Z' 'a-z')
            [ -n "$VID_FINAL" ] && VID=$VID_FINAL
            [ -n "$PID_FINAL" ] && PID=$PID_FINAL
        fi

        if [ -d "/sys/bus/usb-serial/drivers/option1" ]; then
            VID=$(echo "$VID" | sed 's/^0*//')
            PID=$(echo "$PID" | sed 's/^0*//')

            if ! grep -qEi "$VID.*$PID|$PID.*$VID" /sys/bus/usb-serial/drivers/option1/products 2>/dev/null; then
                echo "0x$VID 0x$PID" > /sys/bus/usb-serial/drivers/option1/new_id 2>/dev/null
                sleep 4 # Jeda 4 detik memberikan waktu bagi kernel untuk menciptakan simpul device /dev/
            fi
            
            PORTS=""
            if [ -d "/sys/bus/usb/devices/$DEVICENAME" ]; then
                PORTS=$(find "/sys/bus/usb/devices/$DEVICENAME/" -name "ttyUSB*" -o -name "cdc-wdm*" -o -name "ttyACM*" 2>/dev/null | xargs -I {} basename {} | tr '\n' ' ')
            fi
            
            if [ -z "$PORTS" ]; then
                PORTS=$(ls -d /sys/class/net/* /sys/class/tty/* 2>/dev/null | grep "$DEVICENAME" | xargs -I {} basename {} | grep -E 'ttyUSB|cdc-wdm|ttyACM' | tr '\n' ' ')
            fi
            
            logger -t "MODEM_RAKITAN" "[+] Sukses menyuntikkan USB VID:$VID PID:$PID. Port terikat: [ ${PORTS:-Menunggu Inisialisasi} ]"
        else
            logger -t "MODEM_RAKITAN" "[-] Gagal mengaktifkan port serial. Modul kmod-usb-serial-option belum termuat!"
        fi
        ;;
    *)
        exit 0
        ;;
esac
