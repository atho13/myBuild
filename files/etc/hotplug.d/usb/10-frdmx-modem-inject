#!/bin/sh
# PROPERTY OF: [FRDMX-Wrt]

[ "$ACTION" = "add" ] || exit 0
[ -z "$PRODUCT" ] && exit 0

VID=$(echo "$PRODUCT" | cut -d'/' -f1 | tr 'A-Z' 'a-z')
PID=$(echo "$PRODUCT" | cut -d'/' -f2 | tr 'A-Z' 'a-z')

case "$VID" in
    "2c7c"|"1199"|"2cb7"|"12d1"|"05c6"|"1e0e"|"413c"|"03f0"|"19d2"|"0b3c"|"1546"|"2b7c"|"0489"|"1c9e"|"1bc7")

        sleep 4
        
        if [ -d "/sys/bus/usb/devices/$DEVICENAME" ]; then
            VID_FINAL=$(cat "/sys/bus/usb/devices/$DEVICENAME/idVendor" 2>/dev/null | tr 'A-Z' 'a-z')
            PID_FINAL=$(cat "/sys/bus/usb/devices/$DEVICENAME/idProduct" 2>/dev/null | tr 'A-Z' 'a-z')
            [ -n "$VID_FINAL" ] && VID=$VID_FINAL
            [ -n "$PID_FINAL" ] && PID=$PID_FINAL
        fi

        if [ -n "$DEVICENAME" ]; then
            IFACE_NUM=$(echo "$DEVICENAME" | grep -oE '[0-9]+:[0-9]+\.[0-9]+$' | cut -d'.' -f2)
            
            if [ -n "$IFACE_NUM" ]; then
                if [ "$IFACE_NUM" -eq 12 ] || [ "$IFACE_NUM" -eq 13 ]; then
                    logger -t "FRDMX-ModemInject" "[*] Interface #${IFACE_NUM} terdeteksi sebagai Jalur Jaringan Tinggi. Dilepas secara native untuk QMI/MBIM/ModemManager."
                    exit 0
                fi
            fi
        fi

        if [ -d "/sys/bus/usb-serial/drivers/option1" ]; then
            VID_CLEAN=$(echo "$VID" | sed 's/^0x//')
            PID_CLEAN=$(echo "$PID" | sed 's/^0x//')

            if ! grep -qEi "^$VID_CLEAN[[:space:]]+$PID_CLEAN" /sys/bus/usb-serial/drivers/option1/products 2>/dev/null; then
                echo "$VID_CLEAN $PID_CLEAN" > /sys/bus/usb-serial/drivers/option1/new_id 2>/dev/null
                sleep 3 
            fi
            
            PORTS=""
            if [ -d "/sys/bus/usb/devices/$DEVICENAME" ]; then
                PORTS=$(find "/sys/bus/usb/devices/$DEVICENAME/" -name "ttyUSB*" -o -name "cdc-wdm*" -o -name "ttyACM*" 2>/dev/null | xargs -I {} basename {} | tr '\n' ' ' | sed 's/ $//')
            fi
            
            logger -t "FRDMX-ModemInject" "[+] Sukses menyuntikkan USB VID:$VID_CLEAN PID:$PID_CLEAN ke Driver Option. Port terikat: [ ${PORTS:-Menunggu Inisialisasi} ]"
        else
            logger -t "FRDMX-ModemInject" "[-] Gagal mengaktifkan port serial. Modul kmod-usb-serial-option belum termuat di kernel!"
        fi
        ;;
    *)
        exit 0
        ;;
esac
exit 0
