#!/bin/sh
# For Frdmx-Wrt Community

[ "$ACTION" = "add" ] || exit 0

VID_RAW=$(echo "$PRODUCT" | cut -d'/' -f1 | tr 'A-Z' 'a-z')
PID_RAW=$(echo "$PRODUCT" | cut -d'/' -f2 | tr 'A-Z' 'a-z')

VID=$(printf "%04x" "0x$VID_RAW" 2>/dev/null)
PID=$(printf "%04x" "0x$PID_RAW" 2>/dev/null)

case "$VID" in
    "2c7c"|"2cb7"|"1508"|"1199"|"12d1"|"1bc7"|"1e0e"|"05c6"|"413c"|"03f0"|"19d2"|"0b3c"|"1546"|"2b7c"|"0489"|"9025"|"8087"|"1e2d")

        sleep 3
        
        if [ -d "/sys/bus/usb/devices/$DEVNAME" ]; then
            VID_FINAL=$(cat "/sys/bus/usb/devices/$DEVNAME/idVendor" 2>/dev/null | tr 'A-Z' 'a-z')
            PID_FINAL=$(cat "/sys/bus/usb/devices/$DEVNAME/idProduct" 2>/dev/null | tr 'A-Z' 'a-z')
            [ -n "$VID_FINAL" ] && VID=$(printf "%04x" "0x$VID_FINAL" 2>/dev/null)
            [ -n "$PID_FINAL" ] && PID=$(printf "%04x" "0x$PID_FINAL" 2>/dev/null)
        fi

        if [ -d "/sys/bus/usb-serial/drivers/option1" ]; then
            if ! grep -q "$VID.*$PID" /sys/bus/usb-serial/drivers/option1/products 2>/dev/null; then
                echo "$VID $PID" > /sys/bus/usb-serial/drivers/option1/new_id 2>/dev/null
                sleep 2
            fi
            
            PORTS=$(ls /dev/ | grep -E "ttyUSB[0-9]|cdc-wdm[0-9]" | tr '\n' ' ')
            logger -t "MODEM_HOTPLUG" "[+] Terdeteksi USB VID:$VID PID:$PID. Port aktif: [ $PORTS]"
        else
            logger -t "MODEM_HOTPLUG" "[-] Gagal! Modul kmod-usb-serial-option tidak terpasang di sistem."
        fi
        ;;
    *)
        exit 0
        ;;
esac
