#!/bin/sh
# Custom Multi-Modem - frdmx-Wrt Community
# Designed for built-in firmware distribution

APN="internet"

if [ "$ACTION" = "add" ] && { [ "$SUBSYSTEM" = "tty" ] || [ "$SUBSYSTEM" = "usb" ]; }; then
    if [ -f /sbin/usbmode ]; then
        /sbin/usbmode -f /etc/usb-mode.json 2>/dev/null
    fi

    sleep 8
    MODEM_PORT=""

    for port in /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB3 /dev/ttyUSB4 /dev/ttyACM0 /dev/ttyACM1 /dev/ttyACM2; do
        if [ -c "$port" ]; then
            if exec 3<>"$port"; then
                if chat -t 2 -v "" "AT" "OK" >&3 <&3 2>/dev/null; then
                    echo "[PnP-Modem] Modem terdeteksi pada port: $port" > /dev/kmsg
                    MODEM_PORT="$port"
                    exec 3>&-
                    break
                fi
                exec 3>&-
            fi
        fi
    done

    if [ -n "$MODEM_PORT" ]; then
        echo "[PnP-Modem] Konfigurasi APN dan Fungsionalitas Modem..." > /dev/kmsg
        if exec 3<>"$MODEM_PORT"; then
            chat -t 2 -v "" "AT+CFUN=1" "OK" >&3 <&3 2>/dev/null && sleep 1
            chat -t 2 -v "" "AT+CGDCONT=1,\"IP\",\"$APN\"" "OK" >&3 <&3 2>/dev/null && sleep 1
            chat -t 2 -v "" "AT+EDPRFIX=0" "OK" >&3 <&3 2>/dev/null && sleep 1
            exec 3>&-
        fi

        IFACE_FOUND=""
        for iface in $(uci show network | grep -E "\.proto='(modemmanager|qmi|mbim|3g|ncm)'" | cut -d'.' -f2); do
            if [ -n "$iface" ]; then
                IFACE_FOUND="$iface"
                break
            fi
        done

        if [ -n "$IFACE_FOUND" ]; then
            echo "[PnP-Modem] Memicu interface aktif: $IFACE_FOUND" > /dev/kmsg
            ifup "$IFACE_FOUND" 2>/dev/null
        else
            echo "[PnP-Modem] Protokol spesifik tidak ditemukan. Mencoba interface default..." > /dev/kmsg
            ifup wan 2>/dev/null || ifup wwan 2>/dev/null
        fi
    else
        echo "[PnP-Modem] Driver terbaca, tapi modem belum merespons AT Command." > /dev/kmsg
    fi
fi
