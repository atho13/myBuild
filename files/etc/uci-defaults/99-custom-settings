#!/bin/sh

echo "Clearing root password..."
passwd -d root > /dev/null 2>&1

echo "Setting file permissions..."
for file in \
    /usr/bin/huawei.py \
    /usr/libexec/rpcd/luci-temp \
    /usr/bin/frdmx-andro \
    /usr/sbin/led \
    /usr/sbin/ledon \
    /bin/frdmx_net \
    /sbin/free.sh \
    /sbin/yess \
    /etc/rc.local \
    /etc/custom_service/start_service.sh \
    /etc/init.d/todong \
    /www/vnstati/vnstati.sh \
    /etc/hotplug.d/usb/90-frdmx-modem \
    /etc/hotplug.d/iface/99-frdmx-watchdog; do
    [ -f "$file" ] && chmod +x "$file"
done

echo "Configuring UCI settings via batch..."
uci batch <<EOF
set system.@system[0].hostname='FRDMX'
set system.@system[0].timezone='WIB-7'
set system.@system[0].zonename='Asia/Jakarta'

delete system.ntp.server
add_list system.ntp.server='0.id.pool.ntp.org'
add_list system.ntp.server='1.id.pool.ntp.org'
add_list system.ntp.server='ntp.bmkg.go.id'
add_list system.ntp.server='time.google.com'

delete network.lan_dev
set network.lan_dev=device
set network.lan_dev.name='br-lan'
set network.lan_dev.type='bridge'
add_list network.lan_dev.ports='eth0'
set network.lan_dev.stp='1'
set network.lan_dev.igmp_snooping='1'

delete network.lan
set network.lan=interface
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign='64'

add fstab mount
set fstab.@mount[-1].target='/'
set fstab.@mount[-1].options='noatime,commit=60'
set fstab.@mount[-1].enabled='1'

set network.wan=interface
set network.wan.proto='dhcp'
set network.wan.device='eth1'
set network.wan.metric='5'

set network.tethering=interface
set network.tethering.proto='dhcp'
set network.tethering.device='usb0'
set network.tethering.metric='10'

set network.modem=interface
set network.modem.proto='modemmanager'
set network.modem.device='wwan0'
set network.modem.apn='internet'
set network.modem.auth='none'
set network.modem.metric='20'

delete network.wan6

del_list firewall.@zone[1].network='wan6'
del_list firewall.@zone[1].network='tethering'
del_list firewall.@zone[1].network='modem'
del_list firewall.@zone[1].network='wan'

add_list firewall.@zone[1].network='wan'
add_list firewall.@zone[1].network='tethering'
add_list firewall.@zone[1].network='modem'

set uhttpd.main.index_page='index.php'
set uhttpd.main.interpreter='.php=/usr/bin/php-cgi'

delete dhcp.lan
set dhcp.lan=dhcp
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'

commit network
commit system
commit firewall
commit uhttpd
commit dhcp
commit fstab
EOF

echo "Applying system optimizations..."

sed -i 's/^option check_signature/# option check_signature/g' /etc/opkg.conf 2>/dev/null

if [ -d /sys/block/mmcblk0 ]; then
    echo bfq > /sys/block/mmcblk0/queue/scheduler 2>/dev/null
fi
if [ -d /sys/block/sda ]; then
    echo bfq > /sys/block/sda/queue/scheduler 2>/dev/null
fi

for dev in /sys/bus/usb/devices/*/power/control; do 
    [ -e "$dev" ] && echo "on" > "$dev" 2>/dev/null
done

[ -f /etc/php.ini ] && sed -i 's/^memory_limit.*/memory_limit = 64M/' /etc/php.ini

if [ -f /etc/config/ttyd ] && [ -f /bin/bash ]; then
    uci set ttyd.@ttyd.command='/bin/bash --login'
    uci commit ttyd
    /etc/init.d/ttyd enable
fi

echo "Creating application symlinks for TinyFM..."
mkdir -p /www/tinyfm
ln -sf / /www/tinyfm/rootfs
ln -sf /etc/openclash/ /www/tinyfm/openclash
ln -sf /etc/openclash/ /www/tinyfm/nikki

echo "Registering scripts to Startup (rc.local)..."
sed -i '/start_service.sh/d' /etc/rc.local
sed -i '/\/sbin\/yess/d' /etc/rc.local

if [ -f "/sbin/yess" ]; then
    sed -i '/exit 0/i /sbin/yess &' /etc/rc.local
fi

if [ -f "/etc/custom_service/start_service.sh" ]; then
    sed -i '/exit 0/i (sleep 30 && /bin/sh /etc/custom_service/start_service.sh) &' /etc/rc.local
fi

echo "Updating System Schedules (Crontab)..."
cat > /etc/crontabs/root << 'EOF'
# ============================================================
# PROPERTY OF: [FRDMX-Wrt] - SCHEDULE & AUTOPILOT MAINTENANCE
# ============================================================
# Automatic Restart your Modem Bro..
30 3 * * 0 for iface in wan tethering modem; do ubus call network.interface.$iface down; done && sleep 2 && mmcli -m any --reset >/dev/null 2>&1 && sleep 45 && for iface in wan tethering modem; do ubus call network.interface.$iface up; done

# My Trick (Net Detector tiap 30 menit, jika mo pake bisa hilangkan tanda #)
#*/30 * * * * [ -x /bin/frdmx_net ] && /bin/frdmx_net >/dev/null 2>&1

# Automatic Maintenance Internal your System Bro..
0 * * * * [ -x /sbin/free.sh ] && /sbin/free.sh >/dev/null 2>&1
59 23 * * * sync && sh -c "echo 3 > /proc/sys/vm/drop_caches" && rm -rf /tmp/luci*
*/5 * * * * [ -x /www/vnstati/vnstati.sh ] && /www/vnstati/vnstati.sh >/dev/null 2>&1
EOF

/etc/init.d/cron enable

echo "Applying sysctl changes..."
sysctl -p /etc/sysctl.conf >/dev/null 2>&1

[ -f "/sbin/free.sh" ] && sh /sbin/free.sh >/dev/null 2>&1

echo "Done! Router FRDM-X configuration finished successfully."
exit 0
