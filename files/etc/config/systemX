
config system
	option hostname 'FRDMX'
	option timezone 'WIB-7'
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	option zonename 'Asia/Jakarta'
	option log_proto 'udp'
	option conloglevel '8'
	option cronloglevel '7'
	option zram_size_mb '256'
	option zram_comp_algo 'lz4'

config timeserver 'ntp'
	list server '0.id.pool.ntp.org'
	list server '1.id.pool.ntp.org'
	list server 'ntp.bmkg.go.id'
	list server 'time.google.com'

