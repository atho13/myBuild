# 1. MANGLE TTL 65 - KHUSUS UNTUK INTERNET KELUAR (KE MODEM SELULER / WAN)
# Silahkan tambahkan interface pada oifname jika interface modem kamu belum tersedia (Zona WAN yah Sob..)
chain user_mangle_postrouting {
  type route hook postrouting priority 300; policy accept;
  counter
  oifname { "wan", "usb0", "usb1", "rndis0", "rndis1", "wwan0", "wwan1", "rmnet_data0" } ip ttl set 65
  oifname { "wan", "usb0", "usb1", "rndis0", "rndis1", "wwan0", "wwan1", "rmnet_data0" } ip6 hoplimit set 65
}

# 2. MANGLE TTL 1 - KHUSUS UNTUK INTERNET MASUK (KE KLIEN LAN / WI-FI)
# Memaksa paket ke arah br-lan bernilai TTL 1 supaya klien tidak bisa membagikan koneksi lagi.
