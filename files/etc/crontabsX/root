# Automatic Restart your Modem Bro..
30 3 * * 0 for dev in /dev/ttyUSB* /dev/cdc-wdm*; do [ -e "$dev" ] && (echo AT^RESET | atinout - "$dev" - 2>/dev/null; echo AT+CFUN=1,1 | atinout - "$dev" - 2>/dev/null); done && sleep 60 && for iface in $(ubus call network.interface dump | jsonfilter -e '@.interface[@.data.zone="wan"].interface'); do ubus call network.interface."$iface" down && sleep 2 && ubus call network.interface."$iface" up; done

