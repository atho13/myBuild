#!/bin/sh
# For Frdmx-Wrt Community..

sleep 5

for i in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    if [ -f "$i" ]; then
        AVAILABLE_GOV=$(cat "$(dirname "$i")/scaling_available_governors" 2>/dev/null)
        if echo "$AVAILABLE_GOV" | grep -q "schedutil"; then
            echo "schedutil" > "$i" 2>/dev/null
        elif echo "$AVAILABLE_GOV" | grep -q "performance"; then
            echo "performance" > "$i" 2>/dev/null
        fi
    fi
done

if [ -f /proc/sys/net/core/gro_normal_batch ]; then
    echo "16" > /proc/sys/net/core/gro_normal_batch 2>/dev/null
fi

ARCH=$(uname -m)
CPUS=$(nproc 2>/dev/null)
[ -z "$CPUS" ] && CPUS=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
[ -z "$CPUS" ] && CPUS=2

if [ "$ARCH" = "x86_64" ] || echo "$ARCH" | grep -qE 'i386|i686'; then
    RPS_MASK="f"
    if [ "$CPUS" -gt 4 ] && [ "$CPUS" -le 8 ]; then
        RPS_MASK="ff"
    elif [ "$CPUS" -gt 8 ]; then
        RPS_MASK="ffff"
    fi

    for dev in /sys/class/net/*; do
        IFACE=$(basename "$dev")
        [ "$IFACE" = "lo" ] && continue
        if [ -d "/sys/class/net/$IFACE/queues" ]; then
            for rps in /sys/class/net/"$IFACE"/queues/rx-*/rps_cpus; do
                [ -f "$rps" ] && echo "$RPS_MASK" > "$rps" 2>/dev/null
            done
            for xps in /sys/class/net/"$IFACE"/queues/tx-*/xps_cpus; do
                [ -f "$xps" ] && echo "$RPS_MASK" > "$xps" 2>/dev/null
            done
        fi
    done

elif echo "$ARCH" | grep -qE 'aarch64|arm|mips'; then
    
    ETH_MASK="2"
    [ "$CPUS" -le 1 ] && ETH_MASK="1"
    for eth_irq in $(awk -F: '/(eth|enp|eth0|dwmac|ethernet)/ {print $1}' /proc/interrupts 2>/dev/null | sed 's/ //g'); do
        if echo "$eth_irq" | grep -q '^[0-9]\+$'; then
            if [ -f "/proc/irq/$eth_irq/smp_affinity" ]; then
                echo "$ETH_MASK" > "/proc/irq/$eth_irq/smp_affinity" 2>/dev/null
            fi
        fi
    done

    if [ "$CPUS" -ge 3 ]; then
        USB_MASK="4"
    elif [ "$CPUS" -eq 2 ]; then
        USB_MASK="2"
    else
        USB_MASK="1"
    fi
    for usb_irq in $(awk -F: '/(dwc3|usb|ehci|xhci)/ {print $1}' /proc/interrupts 2>/dev/null | sed 's/ //g'); do
        if echo "$usb_irq" | grep -q '^[0-9]\+$'; then
            if [ -f "/proc/irq/$usb_irq/smp_affinity" ]; then
                echo "$USB_MASK" > "/proc/irq/$usb_irq/smp_affinity" 2>/dev/null
            fi
        fi
    done
fi

for usb_node in /sys/bus/usb/devices/*; do
    if [ -d "$usb_node/power" ]; then
        [ -f "$usb_node/power/control" ] && echo "on" > "$usb_node/power/control" 2>/dev/null
        [ -f "$usb_node/power/autosuspend" ] && echo "-1" > "$usb_node/power/autosuspend" 2>/dev/null
        [ -f "$usb_node/power/autosuspend_delay_ms" ] && echo "-1" > "$usb_node/power/autosuspend_delay_ms" 2>/dev/null
    fi
done

logger -t "Frdmx-Hw-Mod" "[+] Akselerasi CPU, USB Power, & IRQ Affinity sukses diterapkan."
exit 0
