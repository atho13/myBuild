#!/bin/bash
# For Frdmx-Wrt Community..
# Smart Net Detector with Safe Limit Counter

TARGET_PRIMARY_1="https://google.com"
TARGET_PRIMARY_2="https://1.1.1"
TARGET_BACKUP_1="https://biznet.id"
TARGET_BACKUP_2="https://kompas.com"

TIMEOUT_MS=5000
COUNT=2
MAX_RESETS=3

COUNTER_FILE="/tmp/frdmx_net"

check_http() {
    local url=$1
    if httping -q -c "$COUNT" -t "$((TIMEOUT_MS / 1000))" -g "$url" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

echo "[$(date)] Cek koneksi internet..."

if check_http "$TARGET_PRIMARY_1" || check_http "$TARGET_PRIMARY_2"; then
    echo "STATUS: INTERNET OK (Target Utama Merespons)"
    echo "0" > "$COUNTER_FILE"
    exit 0
fi

echo "PERINGATAN: Jalur utama gagal. Mencoba validasi via target lokal (Backup)..."

if check_http "$TARGET_BACKUP_1" || check_http "$TARGET_BACKUP_2"; then
    echo "STATUS: INTERNET OK (Terhubung via Akses Jaringan Lokal / IIX)"
    echo "0" > "$COUNTER_FILE"
    exit 0
fi

CURRENT_COUNT=$(cat "$COUNTER_FILE" 2>/dev/null)
[ -z "$CURRENT_COUNT" ] && CURRENT_COUNT=0

if [ "$CURRENT_COUNT" -ge "$MAX_RESETS" ]; then
    echo "STATUS: INTERNET DOWN TOTAL! Batas maksimal reset ($MAX_RESETS kali) telah tercapai."
    echo "Kemungkinan: Kuota habis / Gangguan massal ISP / BTS Mati."
    echo "Skrip hentikan proses restart otomatis untuk mencegah modem overheat."
    exit 1
fi

echo "STATUS: INTERNET DOWN! Mulai proses pemulihan Bro, harap tunggu (Percobaan ke-$((CURRENT_COUNT + 1)) dari $MAX_RESETS)..."

WAN_INTERFACES=$(uci get firewall.@zone.network 2>/dev/null | tr ' ' '\n' | sed "s/'//g")

if [ -z "$WAN_INTERFACES" ]; then
    WAN_INTERFACES=$(uci show network | grep -E '\.name=' | grep -i 'wan' | awk -F'.' '{print $2}')
fi

for iface in $WAN_INTERFACES; do
    [ "$iface" = "loopback" ] && continue
    echo "Mereset antarmuka modem: $iface ..."
    ifup "$iface" 2>/dev/null
done

CURRENT_COUNT=$((CURRENT_COUNT + 1))
echo "$CURRENT_COUNT" > "$COUNTER_FILE"

echo "Proses pemulihan selesai. Tunggu modem melakukan dial-up ulang."
exit 1
