#!/bin/sh
# frdmx-wrt net detector

LOCKFILE="/tmp/ping_check.lock"
LOGFILE="/var/log/internet_reboot.log"

trap 'rm -f "$LOCKFILE"; exit' INT TERM EXIT
if [ -f "$LOCKFILE" ]; then
    exit 0
fi
touch "$LOCKFILE"

WAN_IFACES=""
for zone in $(uci show firewall | grep -E '\.name='\''wan'\''' | cut -d'.' -f2); do
    WAN_IFACES="$WAN_IFACES $(uci -q get firewall.$zone.network)"
done

if [ -z "$(echo "$WAN_IFACES" | sed 's/ //g')" ]; then
    WAN_IFACES="wan wan2"
fi

for IFACE in $WAN_IFACES; do
    STATUS_DATA=$(ubus call network.interface.$IFACE status 2>/dev/null)
    [ -z "$STATUS_DATA" ] && continue
    
    LOCAL_IP=$(echo "$STATUS_DATA" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
    L3_DEVICE=$(echo "$STATUS_DATA" | jsonfilter -e '@["l3_device"]' 2>/dev/null)
    PROTO=$(echo "$STATUS_DATA" | jsonfilter -e '@["proto"]' 2>/dev/null)

    case "$PROTO" in
        wireguard|openvpn|shadowsocks|v2ray|trojan|tun*|tailscale|zerotier) 
            continue 
            ;;
    esac

    HTTP_CHECK=1

    if [ -z "$LOCAL_IP" ]; then
        echo "$(date): [ $IFACE ] Tidak ada IP Lokal. Menandai putus." >> "$LOGFILE"
        HTTP_CHECK=1
    else
        if curl --interface "$IFACE" --connect-timeout 5 -sI https://google.com > /dev/null || \
           curl --interface "$IFACE" --connect-timeout 5 -sI https://cloudflare.com > /dev/null; then
            HTTP_CHECK=0
        else
            if httping -c 2 -t 5 -G -g https://detik.com > /dev/null || \
               httping -c 2 -t 5 -G -g https://biznetnetworks.com > /dev/null; then
                echo "$(date): [ $IFACE ] Tes utama curl gagal, verifikasi httping sukses. Internet aman." >> "$LOGFILE"
                HTTP_CHECK=0
            else
                echo "$(date): [ $IFACE ] Tes utama curl dan verifikasi httping gagal total!" >> "$LOGFILE"
                HTTP_CHECK=1
            fi
        fi
    fi

    if [ "$HTTP_CHECK" -eq 1 ]; then
        echo "$(date): [ $IFACE / ${L3_DEVICE:-unknown} ] Memulai proses perbaikan jaringan..." >> "$LOGFILE"

        ubus call network.interface.$IFACE down >/dev/null 2>&1
        sleep 2

        if [ "$PROTO" = "modemmanager" ] || [ "$PROTO" = "qmi" ] || [ "$PROTO" = "mbim" ] || [ "$PROTO" = "3g" ]; then
            MODEM_INDEX=$(mmcli -L 2>/dev/null | grep -o '/Modem/[0-9]' | head -n1 | cut -d'/' -f3)
            if [ -n "$MODEM_INDEX" ]; then
                mmcli -m "$MODEM_INDEX" --reset >/dev/null 2>&1
            else
                mmcli -m any --reset >/dev/null 2>&1
            fi
            
            COUNTER=0
            while [ $COUNTER -lt 12 ]; do
                sleep 5
                if mmcli -L 2>/dev/null | grep -q "Modem"; then
                    break
                fi
                COUNTER=$((COUNTER + 1))
            done

        elif [ "$PROTO" = "dhcp" ]; then
            if [ -n "$L3_DEVICE" ] && [ -d "/sys/class/net/$L3_DEVICE/device" ]; then
                USB_TARGET=$(basename "$(readlink -f "/sys/class/net/$L3_DEVICE/device/../..")")
                USB_AUTH_PATH="/sys/bus/usb/devices/$USB_TARGET/authorized"
                
                if [ -e "$USB_AUTH_PATH" ]; then
                    echo 0 > "$USB_AUTH_PATH" 2>/dev/null
                    sleep 3
                    echo 1 > "$USB_AUTH_PATH" 2>/dev/null
                    echo "$(date): [ $IFACE ] Frdmx tool Sukses mereset daya USB pada komponen $USB_TARGET" >> "$LOGFILE"
                fi
            fi
            
            killall -q -SIGUSR2 udhcpc
            sleep 2
            /etc/init.d/network restart >/dev/null 2>&1
            sleep 5
            
        else
            /etc/init.d/network restart >/dev/null 2>&1
            sleep 5
        fi

        ubus call network.interface.$IFACE up >/dev/null 2>&1
        
        sleep 15
        echo "$(date): [ $IFACE ] Perbaikan selesai dan aktif kembali." >> "$LOGFILE"
    fi
done
