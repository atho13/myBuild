#!/bin/sh
# frdmx-wrt net detector

LOCKFILE="/tmp/ping_check.lock"
trap 'rm -f "$LOCKFILE"; exit' INT TERM EXIT
if [ -f "$LOCKFILE" ]; then
    exit 0
fi
touch "$LOCKFILE"

MODEM_IFACES=$(uci show network | grep "proto='modemmanager'" | cut -d'.' -f2)
if [ -z "$MODEM_IFACES" ]; then
    MODEM_IFACES="modem tethering wan"
fi

TEST_IFACE=$(echo $MODEM_IFACES | awk '{print $1}')

LOCAL_IP=$(ubus call network.interface.$TEST_IFACE status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address')

HTTP_CHECK=1

if [ -z "$LOCAL_IP" ]; then
    echo "$(date): $TEST_IFACE tidak memiliki IP Lokal. Langsung eksekusi restart." >> /var/log/internet_reboot.log
    HTTP_CHECK=1
else
    # Jika ada IP lokal, lakukan pengecekan HTTP via IP tersebut
    if httping -c 3 -b "$LOCAL_IP" -g https://google.com -T 3 > /dev/null 2>&1 || \
       httping -c 3 -b "$LOCAL_IP" -g https://cloudflare.com -T 3 > /dev/null 2>&1; then
        HTTP_CHECK=0
    fi
fi

if [ "$HTTP_CHECK" -eq 1 ]; then
    echo "$(date): Internet putus (HTTP Gagal via $TEST_IFACE)! Restart Modem..." >> /var/log/internet_reboot.log

    ubus call network.interface.$TEST_IFACE down >/dev/null 2>&1
    sleep 3

    if ! mmcli -m any --restart-set-to-low-power >/dev/null 2>&1; then
        mmcli -m any --restart >/dev/null 2>&1
    fi

    sleep 45

    ubus call network.interface.$TEST_IFACE up >/dev/null 2>&1
    
    echo "$(date): Perbaikan selesai. Interface [ $TEST_IFACE ] kembali aktif." >> /var/log/internet_reboot.log
fi
