#!/bin/bash
# Script by Lutfa Ilham - FRDMX LED Control

if [ "$(id -u)" != "0" ]; then
  echo "Error: Script ini harus dijalankan sebagai root" 1>&2
  exit 1
fi

GPIO="/sys/class/gpio"
KERNEL_VERSION=$(uname -r | cut -d. -f1,2)

export_gpio() {
  local pin=$1
  if [ ! -z "$pin" ] && [ ! -d "${GPIO}/gpio${pin}" ]; then
    echo "${pin}" > "${GPIO}/export" 2>/dev/null
  fi
  echo out > "${GPIO}/gpio${pin}/direction" 2>/dev/null
}

function dual_general() {
  local status="${1}"
  local pin_on="${2}"
  local pin_off="${3}"

  if [[ -z "$pin_on" || -z "$pin_off" ]]; then return 1; fi

  export_gpio "${pin_on}"
  export_gpio "${pin_off}"

  case "${status}" in
    "on")   echo 0 > "${GPIO}/gpio${pin_off}/value"; echo 1 > "${GPIO}/gpio${pin_on}/value" ;;
    "off")  echo 0 > "${GPIO}/gpio${pin_on}/value";  echo 1 > "${GPIO}/gpio${pin_off}/value" ;;
    "warn") echo 1 > "${GPIO}/gpio${pin_on}/value";  echo 1 > "${GPIO}/gpio${pin_off}/value" ;;
    "dis")  echo 0 > "${GPIO}/gpio${pin_on}/value";  echo 0 > "${GPIO}/gpio${pin_off}/value" ;;
  esac
}

function power() {
  local pin_on="" pin_off=""
  case "$KERNEL_VERSION" in
    6.6|6.12|6.18) pin_on="521"; pin_off="517" ;;
    5.15|6.1)      pin_on="510"; pin_off="506" ;;
  esac
  dual_general "${1}" "${pin_on}" "${pin_off}"
}

function lan() {
  local pin_on="" pin_off=""
  case "$KERNEL_VERSION" in
    6.6|6.12|6.18) pin_on="547"; pin_off="548" ;;
    5.15|6.1)      pin_on="425"; pin_off="426" ;;
  esac
  dual_general "${1}" "${pin_on}" "${pin_off}"
}

function internet() {
  local pin_on="" pin_off=""
  case "$KERNEL_VERSION" in
    6.6|6.12|6.18) pin_on="549"; pin_off="550" ;; 
    5.15|6.1)      pin_on="427"; pin_off="428" ;;
  esac
  dual_general "${1}" "${pin_on}" "${pin_off}"
}

case "${1}" in
  -power)    power "${2}" ;;
  -lan)      lan "${2}" ;;
  -internet) internet "${2}" ;;
  -l)
    power on
    internet off
    while true; do sleep 60; done
    ;;
  -s)
    power dis; lan dis; internet dis
    ;;
  *)
    echo "Usage: $0 [-power|-lan|-internet] [on|off|warn|dis] or [-l|-s]"
    ;;
esac
