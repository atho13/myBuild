#!/bin/sh

# ====================================================================
# SKRIP SETUP OTOMATIS OPENWRT - EDISI KOMUNITAS X86_64 IPv4 (FRDMX)
# JALUR: files/etc/uci-defaults/99-frdmx-setup
# ====================================================================

echo "================================================="
echo "   Memulai Konfigurasi Otomatis FRDMX x86_64..."
echo "================================================="

echo "[*] Menghapus password root default (Keamanan Awal)..."
passwd -d root > /dev/null 2>&1

echo "[*] Mengatur izin eksekusi berkas sistem..."
for file in \
    /usr/bin/huawei.py \
    /usr/libexec/rpcd/luci-temp \
    /usr/bin/frdmx-andro \
    /bin/frdmx_net \
    /sbin/free.sh \
    /sbin/yess \
    /etc/rc.local \
    /etc/custom_service/start_service.sh \
    /etc/init.d/todong \
    /www/vnstati/vnstati.sh \
    /www/cgi-bin/traffic \
    /etc/hotplug.d/usb/90-frdmx-modem \
    /etc/hotplug.d/iface/99-frdmx-watchdog; do
    if [ -f "$file" ]; then
        chmod +x "$file"
    fi
done

echo "[*] Mengonfigurasi pengaturan UCI secara massal (Fokus IPv4)..."
uci batch <<EOF
# 1. Konfigurasi Sistem & Waktu (NTP)
set system.@system[0].hostname='FRDMX'
set system.@system[0].timezone='WIB-7'
set system.@system[0].zonename='Asia/Jakarta'

delete system.ntp.server
add_list system.ntp.server='0.id.pool.ntp.org'
add_list system.ntp.server='1.id.pool.ntp.org'
add_list system.ntp.server='ntp.bmkg.go.id'
add_list system.ntp.server='time.google.com'

# 2. Konfigurasi Jaringan LAN (Fokus IPv4 murni)
delete network.lan
set network.lan=interface
set network.lan.device='eth0'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign=''

# 3. Konfigurasi WAN Fisik x86 (eth1)
set network.wan=interface
set network.wan.proto='dhcp'
set network.wan.device='eth1'
set network.wan.metric='5'

# 4. Konfigurasi Multi-WAN (Tethering USB & Modem)
set network.tethering=interface
set network.tethering.proto='dhcp'
set network.tethering.device='usb0'
set network.tethering.metric='10'

set network.modem=interface
set network.modem.proto='modemmanager'
set network.modem.device='wwan0'
set network.modem.apn='internet'
set network.modem.auth='none'
set network.modem.metric='20'

# 5. Hapus total antarmuka WAN6 IPv6
delete network.wan6

# 6. Konfigurasi DHCP Server IPv4 Only & Matikan DHCPv6 / SLAAC
delete dhcp.lan
set dhcp.lan=dhcp
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'

# 7. Konfigurasi uhttpd (Hanya Bind ke IPv4 untuk Keamanan)
delete uhttpd.main.listen_http
delete uhttpd.main.listen_https
add_list uhttpd.main.listen_http='0.0.0.0:80'
add_list uhttpd.main.listen_https='0.0.0.0:443'
set uhttpd.main.redirect_https='0'
set uhttpd.main.home='/www'
set uhttpd.main.rfc1918_filter='1'
set uhttpd.main.max_requests='50'
set uhttpd.main.max_connections='100'
set uhttpd.main.cgi_prefix='/cgi-bin'
del_list uhttpd.main.interpreter='.php=/usr/bin/php-cgi'
add_list uhttpd.main.interpreter='.php=/usr/bin/php-cgi'
set uhttpd.main.index_page='index.html, index.php'
set uhttpd.main.script_timeout='3600'
set uhttpd.main.network_timeout='30'
set uhttpd.main.http_keepalive='20'
set uhttpd.main.tcp_keepalive='1'
set uhttpd.main.ubus_prefix='/ubus'

# 8. Eksekusi Penyimpanan
commit system
commit network
commit dhcp
commit uhttpd
EOF

# Konfigurasi fstab aman tanpa indeks negatif
uci set fstab.root_mount=mount
uci set fstab.root_mount.target='/'
uci set fstab.root_mount.options='noatime,commit=60'
uci set fstab.root_mount.enabled='1'
uci commit fstab

echo "[*] Menyinkronkan zona Firewall (Hanya Multi-WAN IPv4)..."
i=0
while true; do
    zone_name=$(uci -q get firewall.@zone[$i].name)
    if [ -z "$zone_name" ]; then
        break
    fi
    if [ "$zone_name" = "wan" ]; then
        uci -q delete firewall.@zone[$i].network
        uci add_list firewall.@zone[$i].network='wan'
        uci add_list firewall.@zone[$i].network='tethering'
        uci add_list firewall.@zone[$i].network='modem'
        uci commit firewall
        break
    fi
    i=$((i+1))
done

echo "[*] Menerapkan optimalisasi sistem firmware..."
if [ -f /etc/opkg.conf ]; then
    sed -i 's/^option check_signature/# option check_signature/g' /etc/opkg.conf 2>/dev/null
fi

# Penjadwal I/O untuk media penyimpanan x86_64 (SATA SSD & NVMe)
if [ -d /sys/block/mmcblk0 ]; then echo bfq > /sys/block/mmcblk0/queue/scheduler 2>/dev/null; fi
if [ -d /sys/block/sda ]; then echo bfq > /sys/block/sda/queue/scheduler 2>/dev/null; fi
if [ -d /sys/block/nvme0n1 ]; then echo bfq > /sys/block/nvme0n1/queue/scheduler 2>/dev/null; fi

# Manajemen Daya USB (Mencegah modem putus koneksi)
for dev in /sys/bus/usb/devices/*/power/control; do 
    if [ -f "$dev" ]; then
        echo "on" > "$dev" 2>/dev/null
    fi
done

if [ -f /etc/php.ini ]; then
    sed -i 's/^memory_limit.*/memory_limit = 64M/' /etc/php.ini 2>/dev/null
fi

# Pembersihan entri bentrokan USB modeswitch
if [ -f /etc/usb-mode.json ]; then
    sed -i -e '/12d1:15c1/,+5d' -e '/413c:81d7/,+5d' /etc/usb-mode.json 2>/dev/null
fi

# Menonaktifkan modul XMM-Modem bawaan
if uci -q get xmm-modem.@xmm-modem[0] >/dev/null; then
    uci set xmm-modem.@xmm-modem[0].enable='0'
    uci commit xmm-modem
fi

echo "[*] Membuat tautan simbolis (Symlinks) untuk TinyFM..."
mkdir -p /www/tinyfm
if [ ! -L /www/tinyfm/rootfs ]; then ln -sf / /www/tinyfm/rootfs; fi
if [ -d /etc/openclash ]; then ln -sf /etc/openclash/ /www/tinyfm/openclash 2>/dev/null; fi
if [ -d /etc/nikki ]; then ln -sf /etc/nikki/ /www/tinyfm/nikki 2>/dev/null; fi

echo "[*] Mendaftarkan skrip otomatis ke Startup (rc.local)..."
if [ -f /etc/rc.local ]; then
    sed -i '/_service.sh/d' /etc/rc.local 2>/dev/null
    sed -i '/\/sbin\/yess/d' /etc/rc.local 2>/dev/null

    if [ -f "/etc/custom_service/start_service.sh" ]; then
        sed -i '/exit 0/i (sleep 30 && /bin/sh /etc/custom_service/start_service.sh) &' /etc/rc.local
    fi

    if [ -f "/sbin/yess" ]; then
        sed -i '/exit 0/i /sbin/yess &' /etc/rc.local
    fi
else
    echo "[!] Peringatan: /etc/rc.local tidak ditemukan."
fi

echo "[*] Menerapkan perizinan crontabs dan eksekusi Sysctl Repo..."
if [ -f /etc/crontabs/root ]; then
    chmod 600 /etc/crontabs/root 2>/dev/null
fi

# Memicu kernel untuk membaca file sysctl.conf premium Anda yang ada di repo
if [ -f /etc/sysctl.conf ]; then
    sysctl -p /etc/sysctl.conf >/dev/null 2>&1
fi

if [ -f "/sbin/free.sh" ]; then
    sh /sbin/free.sh >/dev/null 2>&1
fi

echo "================================================="
echo "   Selesai! Pengaturan x86_64 Sukses.            "
echo "================================================="
exit 0
