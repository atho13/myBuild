#!/bin/sh
# Watchdog khusus HP Android via USB Tethering - Frdmx-Wrt Community

export ADB_VENDOR_KEYS=/etc/adb
mkdir -p /etc/adb

HOST1="8.8.8.8"
HOST2="1.1.1.1"
HOST3="9.9.9.9"

failed_count=0
pingfail=3        # Berapa kali gagal berturut-turut sebelum mode pesawat
WAIT_TIME=5       # Jeda waktu (detik) saat mode pesawat aktif

enable_airplane_mode() {
    echo "$(date +"%Y-%m-%d %H:%M:%S") - [ADB-HP] Mengaktifkan mode pesawat di HP..." > /dev/kmsg
    adb shell cmd connectivity airplane-mode enable >/dev/null 2>&1
    adb shell settings put global airplane_mode_on 1 >/dev/null 2>&1
    adb shell am broadcast -a android.intent.action.AIRPLANE_MODE >/dev/null 2>&1
}

disable_airplane_mode() {
    echo "$(date +"%Y-%m-%d %H:%M:%S") - [ADB-HP] Menonaktifkan mode pesawat di HP..." > /dev/kmsg
    adb shell cmd connectivity airplane-mode disable >/dev/null 2>&1
    adb shell settings put global airplane_mode_on 0 >/dev/null 2>&1
    adb shell am broadcast -a android.intent.action.AIRPLANE_MODE >/dev/null 2>&1
}

get_active_wan_interface() {
    local iface=""
    
    for check_iface in usb0 usb1 rndis0 rndis1; do
        if ifconfig "$check_iface" >/dev/null 2>&1; then
            echo "$check_iface"
            return 0
        fi
    done

    # Fallback ke pencarian uci jika user menamai custom device-nya
    for uci_iface in $(uci -q show network | grep -E "\.proto='dhcp'" | cut -d'.' -f2); do
        iface=$(uci -q get network."$uci_iface".device || uci -q get network."$uci_iface".ifname)
        if echo "$iface" | grep -qE 'usb|rndis'; then
            if ifconfig "$iface" >/dev/null 2>&1; then
                echo "$iface"
                return 0
            fi
        fi
    done
    
    echo "usb0"
}

adb start-server >/dev/null 2>&1
echo "[ADB-HP] Mulai pengawasan internet USB Tethering Android dengan proteksi Multi-Modem..." > /dev/kmsg

while true; do
    INTERFACE=$(get_active_wan_interface)
    
    if ! ifconfig "$INTERFACE" >/dev/null 2>&1; then
        echo "[ADB-HP] Peringatan: Jalur interface $INTERFACE terputus fisik (Kabel dicopot?). Menanti..." > /dev/kmsg
        sleep 20
        continue
    fi

    PING_RESULT1=$(ping -c 1 -W 3 -I "$INTERFACE" "$HOST1" 2>&1)
    PING_RESULT2=$(ping -c 1 -W 3 -I "$INTERFACE" "$HOST2" 2>&1)
    PING_RESULT3=$(ping -c 1 -W 3 -I "$INTERFACE" "$HOST3" 2>&1)

    if echo "$PING_RESULT1" | grep -qE "seq=|time=" || \
       echo "$PING_RESULT2" | grep -qE "seq=|time=" || \
       echo "$PING_RESULT3" | grep -qE "seq=|time="; then
        failed_count=0
    else
        failed_count=$((failed_count + 1))
        echo "$(date +"%Y-%m-%d %H:%M:%S") - [ADB-HP] Internet drop pada jalur $INTERFACE! Percobaan kegagalan: $failed_count/$pingfail" > /dev/kmsg
        
        if [ $failed_count -ge $pingfail ]; then
            if adb devices 2>/dev/null | grep -v "List" | grep -q "device"; then
                echo "[ADB-HP] Amang gagal terpenuhi. Mengeksekusi penyegaran sinyal HP via ADB..." > /dev/kmsg
                enable_airplane_mode
                sleep "$WAIT_TIME"
                disable_airplane_mode
                
                sleep 35
            else
                echo "[ADB-HP] Perintah gagal dikirim! Status HP: Belum di-klik 'Izinkan Debugging USB' pada layar HP pengguna." > /dev/kmsg
                sleep 15
            fi
            failed_count=0
        fi
    fi
    sleep 15
done
