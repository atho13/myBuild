#!/bin/sh
. /usr/share/libubox/jshn.sh

case "$1" in
    list)
        echo '{ "get_temp": {}, "get_cpu": {}, "get_traffic": {} }'
    ;;
    call)
        case "$2" in
            get_temp)
                RAW=""

                for zone in 0 1 2 3 4 5; do
                    if [ -f "/sys/class/thermal/thermal_zone${zone}/temp" ]; then
                        VAL=$(cat "/sys/class/thermal/thermal_zone${zone}/temp" 2>/dev/null)
                        if [ -n "$VAL" ] && [ "$VAL" -gt 0 ] 2>/dev/null; then
                            RAW="$VAL"
                            break
                        fi
                    fi
                done

                if [ -z "$RAW" ]; then
                    for hwmon in /sys/class/hwmon/hwmon*/temp*_input; do
                        if [ -f "$hwmon" ]; then
                            VAL=$(cat "$hwmon" 2>/dev/null)
                            if [ -n "$VAL" ] && [ "$VAL" -gt 0 ] 2>/dev/null; then
                                RAW="$VAL"
                                break
                            fi
                        fi
                    done
                fi

                [ -z "$RAW" ] && RAW="0"

                json_init
                json_add_int "raw" "$RAW"
                json_dump
            ;;
            get_cpu)
                if [ -f /proc/stat ]; then
                    CPU_INFO=$(grep '^cpu ' /proc/stat)
                    json_init
                    json_add_string "stat" "$CPU_INFO"
                    json_dump
                fi
            ;;
            get_traffic)
                if [ -f /proc/net/dev ]; then
                    TOTALS=$(sed 's/://g' /proc/net/dev | awk 'NR>2 {if($1 != "lo") {rx+=$2; tx+=$10}} END {print rx, tx}')
                    
                    RX=$(echo "$TOTALS" | awk '{print $1}')
                    TX=$(echo "$TOTALS" | awk '{print $2}')
                    
                    json_init
                    json_add_int "rx" "${RX:-0}"
                    json_add_int "tx" "${TX:-0}"
                    json_dump
                fi  
            ;;
        esac
    ;;
esac
